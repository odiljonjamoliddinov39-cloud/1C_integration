// Общий модуль PlatformAPI (расширение PlatformAPI).
// Свойства: Сервер ✔, Внешнее соединение ✔, Клиент ✘, Вызов сервера ✘, Привилегированный ✘.
// Без привилегированного режима действуют права пользователя 1С, под которым подключилось приложение.
//
// Каждая экспортная функция принимает и возвращает одну строку JSON. Ответ всегда конверт:
//   {"ok": true, "data": ...}  или  {"ok": false, "error": {"code": "...", "message": "...", "details": {...}}}
// Контракт: packages/shared/src/platform-api.ts. Имена объектов конфигурации: PlatformAPI_Map.
//
// Правила записи (ТЗ §5): документы записываются без проведения; сначала проверяется ExternalID;
// вся запись — одна транзакция; каждая запись регистрируется в справочнике PlatformLog.
// ExternalID ищется в PlatformLog, поэтому документы конфигурации не заимствуются и не меняются.

#Область ПрограммныйИнтерфейс

// Ping() -> {configuration: {name, synonym, version}, platformVersion, extensionVersion, infobase}
Функция Ping() Экспорт
	Попытка
		Конфигурация = Новый Структура("name, synonym, version", Метаданные.Имя, Метаданные.Синоним, Метаданные.Версия);
		Результат = Новый Структура;
		Результат.Вставить("configuration", Конфигурация);
		СистемнаяИнфо = Новый СистемнаяИнформация;
		Результат.Вставить("platformVersion", СистемнаяИнфо.ВерсияПриложения);
		Результат.Вставить("extensionVersion", PlatformAPI_Map.ВерсияРасширения());
		Результат.Вставить("infobase", СтрокаСоединенияИнформационнойБазы());
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// GetOrganizations() -> [{ref, name, inn}]
Функция GetOrganizations() Экспорт
	Попытка
		Имена = PlatformAPI_Map.Организации();
		Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование,
		|	Т.%1 КАК ИНН
		|ИЗ
		|	Справочник.%2 КАК Т
		|ГДЕ
		|	НЕ Т.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.Наименование", Имена.ИНН, Имена.Справочник));
		Результат = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("ref, name, inn",
				УИД(Выборка.Ссылка), Выборка.Наименование, СокрЛП(Выборка.ИНН)));
		КонецЦикла;
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// GetMetadata({"objects": ["Документ.СчетФактураПолученный", ...]})
//   -> [{fullName, synonym, attributes: [{name, synonym, types}], tabularSections: [{name, synonym, attributes}]}]
// Объекты, которых нет в конфигурации, пропускаются.
Функция GetMetadata(ПараметрыJSON) Экспорт
	Попытка
		Параметры = ПрочитатьВход(ПараметрыJSON);
		Объекты = Параметры.Получить("objects");
		Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
			ВызватьОшибку("VALIDATION", "objects должен быть массивом полных имён объектов");
		КонецЕсли;
		Результат = Новый Массив;
		Для Каждого ПолноеИмя Из Объекты Цикл
			МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
			Если МД <> Неопределено Тогда
				Результат.Добавить(ОписаниеОбъекта(МД));
			КонецЕсли;
		КонецЦикла;
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// RunQuery({"query": "ВЫБРАТЬ ...", "params": {"Имя": значение}, "limit": 200, "refs": false})
//   -> {columns: [имя], rows: [[значение]], truncated}
// Только чтение: язык запросов 1С не изменяет данные. Права — пользователя 1С, под которым подключились.
// Строки параметров вида "2026-01-31" становятся датами. Ссылки и перечисления возвращаются
// представлением, а с "refs": true — объектом {type, ref, name} (нужно, чтобы потом изменить объект).
// Даты — строкой yyyy-MM-ddTHH:mm:ss. Не больше limit строк (по умолчанию 200, до 1000).
Функция RunQuery(ПараметрыJSON) Экспорт
	Попытка
		Параметры = ПрочитатьВход(ПараметрыJSON);
		Запрос = Новый Запрос(Строка(Обязательно(Параметры, "query")));
		Лимит = Параметры.Получить("limit");
		Лимит = ?(ТипЗнч(Лимит) = Тип("Число"), Мин(Макс(Цел(Лимит), 1), 1000), 200);
		СоСсылками = Параметры.Получить("refs") = Истина;
		ЗначенияПараметров = Параметры.Получить("params");
		Если ТипЗнч(ЗначенияПараметров) = Тип("Соответствие") Тогда
			Для Каждого Параметр Из ЗначенияПараметров Цикл
				Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеПараметраЗапроса(Параметр.Значение));
			КонецЦикла;
		КонецЕсли;
		Попытка
			РезультатЗапроса = Запрос.Выполнить();
		Исключение
			ВызватьОшибку("QUERY_ERROR", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Колонки = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Колонки.Добавить(Колонка.Имя);
		КонецЦикла;
		Выборка = РезультатЗапроса.Выбрать();
		Строки = Новый Массив;
		Обрезано = Ложь;
		Пока Выборка.Следующий() Цикл
			Если Строки.Количество() = Лимит Тогда
				Обрезано = Истина;
				Прервать;
			КонецЕсли;
			Значения = Новый Массив;
			Для Индекс = 0 По Колонки.ВГраница() Цикл
				Значения.Добавить(ЗначениеВJSON(Выборка.Получить(Индекс), СоСсылками));
			КонецЦикла;
			Строки.Добавить(Значения);
		КонецЦикла;

		Результат = Новый Структура("columns, rows, truncated", Колонки, Строки, Обрезано);
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// CreateInvoiceReceived(счёт-фактура JSON) -> {ref, number, date, posted: false, duplicate}
// Вход: InvoiceReceivedInput из packages/shared. Ссылки ищутся по ref, иначе по ИНН / ИКПУ / наименованию;
// недостающий контрагент или номенклатура — ошибка (создаются только после проверки человеком, фаза 1).
Функция CreateInvoiceReceived(ДанныеJSON) Экспорт
	Попытка
		Возврат Успех(СоздатьСчетФактуруПолученный(ПрочитатьВход(ДанныеJSON)));
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// PreviewInvoiceIssued({"sale": {"ref": "..."} | {"number": "...", "date": "YYYY-MM-DD"}})
//   -> {sale: {ref, number, date, organization, counterparty, amount, posted}, existing: {ref, number, date} | null}
// Ничего не записывает: показывает, на основании какой реализации будет счёт-фактура и нет ли его уже.
Функция PreviewInvoiceIssued(ПараметрыJSON) Экспорт
	Попытка
		Имена = PlatformAPI_Map.СчетФактураВыданный();
		Реализация = НайтиРеализацию(Обязательно(ПрочитатьВход(ПараметрыJSON), "sale"), Имена);
		Существующий = СчетФактураПоРеализации(Реализация, Имена);
		Результат = Новый Структура;
		Результат.Вставить("sale", ОписаниеРеализации(Реализация, Имена));
		Результат.Вставить("existing", ?(Существующий = Неопределено, Неопределено, ОписаниеДокумента(Существующий)));
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// CreateInvoiceIssued({"sale": ...}) -> {ref, number, date, posted: false, duplicate}
// Счёт-фактура выданный на основании реализации, без проведения. Если для реализации он уже есть
// (создан приложением или вручную), возвращается существующий.
Функция CreateInvoiceIssued(ПараметрыJSON) Экспорт
	Попытка
		Возврат Успех(СоздатьСчетФактуруВыданный(ПрочитатьВход(ПараметрыJSON)));
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// GetObject({"object": "Справочник.Контрагенты", "ref": "..."})
//   -> {object, ref, presentation, posted, deletionMark, version, fields: {имя: значение}, tables: {имя: [строки]}}
// Ссылки — объектом {type, ref, name}, как в RunQuery с "refs": true. Строк табличной части не больше 200.
Функция GetObject(ПараметрыJSON) Экспорт
	Попытка
		Параметры = ПрочитатьВход(ПараметрыJSON);
		МД = ОбъектМетаданныхДляИзменения(Строка(Обязательно(Параметры, "object")));
		Ссылка = СсылкаОбъекта(МД, Обязательно(Параметры, "ref"));
		Объект = Ссылка.ПолучитьОбъект();
		Поля = Новый Соответствие;
		Для Каждого СР Из МД.СтандартныеРеквизиты Цикл
			Если СР.Имя <> "Ссылка" И СР.Имя <> "ВерсияДанных" Тогда
				Попытка
					Поля.Вставить(СР.Имя, ЗначениеВJSON(Объект[СР.Имя], Истина));
				Исключение
					// стандартный реквизит, которого у этого объекта нет (например, Владелец)
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Реквизит Из МД.Реквизиты Цикл
			Поля.Вставить(Реквизит.Имя, ЗначениеВJSON(Объект[Реквизит.Имя], Истина));
		КонецЦикла;
		Таблицы = Новый Соответствие;
		Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
			Строки = Новый Массив;
			Для Каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
				Если Строки.Количество() = 200 Тогда
					Прервать;
				КонецЕсли;
				Колонки = Новый Соответствие;
				Для Каждого Колонка Из ТЧ.Реквизиты Цикл
					Колонки.Вставить(Колонка.Имя, ЗначениеВJSON(СтрокаТЧ[Колонка.Имя], Истина));
				КонецЦикла;
				Строки.Добавить(Колонки);
			КонецЦикла;
			Таблицы.Вставить(ТЧ.Имя, Строки);
		КонецЦикла;
		Результат = ОписаниеСостояния(Объект, МД);
		Результат.Вставить("fields", Поля);
		Результат.Вставить("tables", Таблицы);
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// PreviewChange({"action": "create" | "update" | "delete" | "undelete", "object": "Документ.X" | "Справочник.X",
//   "ref": "...", "fields": {имя: значение}, "tables": {имя: [строки]}, "post": true | false})
//   -> {action, object, ref, presentation, posted, willPost, deletionMark, version, changes, tables, warnings}
// Ничего не записывает: собирает объект в памяти и показывает, что изменится. Значение ссылочного
// поля: {"ref": УИД} | {"find": {поле: значение}} | {"name": наименование} | {"code": код}, с "type", когда
// поле допускает несколько типов; перечисление — именем значения; дата — "YYYY-MM-DD[THH:mm:ss]".
// "tables" заменяет табличную часть целиком. Удаление — пометка на удаление (её можно снять: "undelete").
// Документ проводится, если "post": true; изменённый проведённый документ перепроводится, если не "post": false.
Функция PreviewChange(ПараметрыJSON) Экспорт
	Попытка
		Возврат Успех(ПодготовитьИзменение(ПрочитатьВход(ПараметрыJSON)).Описание);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// ApplyChange(то же, что PreviewChange, и "version" из PreviewChange для update/delete/undelete)
//   -> {object, ref, presentation, posted, deletionMark, version}
// Одна транзакция вместе с записью в журнал PlatformLog. Если объект изменили после просмотра — CONFLICT.
Функция ApplyChange(ПараметрыJSON) Экспорт
	Попытка
		Данные = ПрочитатьВход(ПараметрыJSON);
		НачатьТранзакцию();
		Попытка
			PlatformAPI_Log.Заблокировать();
			Изменение = ПодготовитьИзменение(Данные);
			Если Изменение.Описание.action <> "create" И Изменение.Описание.version <> Строка(Данные.Получить("version")) Тогда
				ВызватьОшибку("CONFLICT", "Объект изменили после просмотра: покажите изменение заново");
			КонецЕсли;
			ЗаписатьИзменение(Изменение);
			PlatformAPI_Log.ЗаписатьИзменение(Изменение.Описание.action, Изменение.Объект.Ссылка, ВJSON(Изменение.Описание));
			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		Возврат Успех(ОписаниеСостояния(Изменение.Объект, Изменение.МД));
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// PreviewDeleteMarked({"types": ["Документ.X", ...]}) -> {total, types: [{type, presentation, count}], otherSessions: [...]}
// Ничего не удаляет: объекты, помеченные на удаление, по видам (необязательный отбор "types"), и чужие
// сеансы 1С, из-за которых удаление не получится (ему нужна база целиком). Журнал PlatformLog не удаляется никогда.
Функция PreviewDeleteMarked(ПараметрыJSON) Экспорт
	Попытка
		Данные = ПрочитатьВход(ПараметрыJSON);
		Описание = ОписаниеПомеченных(ПомеченныеДляУдаления(Данные));
		Описание.Вставить("otherSessions", ДругиеСеансы());
		Возврат Успех(Описание);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// DeleteMarked({"types": [...]}) -> {total, deleted, kept, keptTypes, reasons}
// Удаляет помеченные объекты насовсем, как «Удаление помеченных объектов» в 1С: в монопольном режиме и с
// контролем ссылок (объект, на который ещё есть ссылки, остаётся). Если базой пользуются другие сеансы —
// BASE_BUSY с их списком. Вызывается только после подтверждения пользователя. Запись в журнал PlatformLog.
Функция DeleteMarked(ПараметрыJSON) Экспорт
	Попытка
		Данные = ПрочитатьВход(ПараметрыJSON);
		Помеченные = ПомеченныеДляУдаления(Данные);
		Результат = Новый Структура("total, deleted, kept, keptTypes, reasons", Помеченные.Количество(), 0, 0, Новый Массив, Новый Массив);
		Если Помеченные.Количество() = 0 Тогда
			Возврат Успех(Результат);
		КонецЕсли;
		Попытка
			УстановитьМонопольныйРежим(Истина);
		Исключение
			ВызватьОшибку("BASE_BUSY", "Не удалось занять базу: ею пользуются другие сеансы 1С",
				Новый Структура("sessions", ДругиеСеансы()));
		КонецПопытки;
		Причины = Новый Массив;
		Попытка
			УдалитьПомеченные(Помеченные, Причины);
		Исключение
			УстановитьМонопольныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьМонопольныйРежим(Ложь);
		Осталось = ОписаниеПомеченных(ПомеченныеДляУдаления(Данные));
		Результат.deleted = Помеченные.Количество() - Осталось.total;
		Результат.kept = Осталось.total;
		Результат.keptTypes = Осталось.types;
		Результат.reasons = Причины;
		Попытка
			PlatformAPI_Log.ЗаписатьУдаление(ВJSON(Результат));
		Исключение
			// удаление уже выполнено; нет права записать журнал — не повод скрыть результат
		КонецПопытки;
		Возврат Успех(Результат);
	Исключение
		Возврат ОшибкаИзИсключения(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Удаление

// Помеченные на удаление объекты (ссылки), без журнала PlatformLog; "types" оставляет только эти виды.
Функция ПомеченныеДляУдаления(Данные)
	Типы = Данные.Получить("types");
	Отбор = Неопределено;
	Если ТипЗнч(Типы) = Тип("Массив") И Типы.Количество() > 0 Тогда
		Отбор = Новый Соответствие;
		Для Каждого Имя Из Типы Цикл
			Отбор.Вставить(Строка(Имя), Истина);
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Ссылка Из НайтиПомеченныеНаУдаление() Цикл
		ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
		Если ПолноеИмя = "Справочник.PlatformLog" Тогда
			Продолжить;
		КонецЕсли;
		Если Отбор <> Неопределено И Отбор.Получить(ПолноеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОписаниеПомеченных(Помеченные)
	Количества = Новый Соответствие;
	Представления = Новый Соответствие;
	Для Каждого Ссылка Из Помеченные Цикл
		МД = Ссылка.Метаданные();
		Имя = МД.ПолноеИмя();
		Было = Количества.Получить(Имя);
		Количества.Вставить(Имя, ?(Было = Неопределено, 0, Было) + 1);
		Представления.Вставить(Имя, МД.Представление());
	КонецЦикла;
	Виды = Новый Массив;
	Для Каждого Элемент Из Количества Цикл
		Виды.Добавить(Новый Структура("type, presentation, count", Элемент.Ключ, Представления.Получить(Элемент.Ключ), Элемент.Значение));
	КонецЦикла;
	Возврат Новый Структура("total, types", Помеченные.Количество(), Виды);
КонецФункции

// Сначала всей пачкой с контролем ссылок; если один объект с ссылками остановил пачку — по одному,
// собирая причины (первые пять), чтобы остальное всё же удалилось.
Процедура УдалитьПомеченные(Помеченные, Причины)
	Попытка
		УдалитьОбъекты(Помеченные, Истина);
		Возврат;
	Исключение
	КонецПопытки;
	Для Каждого Ссылка Из Помеченные Цикл
		Попытка
			Один = Новый Массив;
			Один.Добавить(Ссылка);
			УдалитьОбъекты(Один, Истина);
		Исключение
			Если Причины.Количество() < 5 Тогда
				Причины.Добавить(Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Другие сеансы этой базы: они не дадут занять базу целиком. Чтение списка требует права администрирования;
// без него список пуст, а BASE_BUSY всё равно скажет, что база занята.
Функция ДругиеСеансы()
	Результат = Новый Массив;
	Попытка
		Текущий = НомерСеансаИнформационнойБазы();
		Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
			Если Сеанс.НомерСеанса = Текущий Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("number, application, user, computer, startedAt",
				Сеанс.НомерСеанса, Строка(Сеанс.ИмяПриложения), Строка(Сеанс.Пользователь),
				Сеанс.ИмяКомпьютера, ДатаВСтроку(Сеанс.НачалоСеанса)));
		КонецЦикла;
	Исключение
		Результат = Новый Массив;
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Изменение

Функция ПодготовитьИзменение(Данные)
	Действие = Строка(Обязательно(Данные, "action"));
	Если Действие <> "create" И Действие <> "update" И Действие <> "delete" И Действие <> "undelete" Тогда
		ВызватьОшибку("VALIDATION", "action: create, update, delete или undelete");
	КонецЕсли;
	МД = ОбъектМетаданныхДляИзменения(Строка(Обязательно(Данные, "object")));
	ЭтоДокумент = Метаданные.Документы.Содержит(МД);
	Если Действие = "create" Тогда
		Объект = ?(ЭтоДокумент, Документы[МД.Имя].СоздатьДокумент(), Справочники[МД.Имя].СоздатьЭлемент());
		Объект.Заполнить(Неопределено); // значения по умолчанию, как у новой формы
	Иначе
		Объект = СсылкаОбъекта(МД, Обязательно(Данные, "ref")).ПолучитьОбъект();
	КонецЕсли;
	БылПроведен = ЭтоДокумент И Действие <> "create" И Объект.Проведен;
	Версия = ?(Действие = "create", "", Строка(Объект.ВерсияДанных));

	Изменения = Новый Массив;
	ИзмененияТаблиц = Новый Массив;
	Предупреждения = Новый Массив;
	Если Действие = "create" Или Действие = "update" Тогда
		Поля = Данные.Получить("fields");
		Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
			Для Каждого Поле Из Поля Цикл
				УстановитьПоле(Объект, МД, Поле.Ключ, Поле.Значение, Изменения);
			КонецЦикла;
		КонецЕсли;
		Таблицы = Данные.Получить("tables");
		Если ТипЗнч(Таблицы) = Тип("Соответствие") Тогда
			Для Каждого Таблица Из Таблицы Цикл
				ЗаменитьТаблицу(Объект, МД, Таблица.Ключ, Таблица.Значение, ИзмененияТаблиц);
			КонецЦикла;
		КонецЕсли;
		Если Изменения.Количество() = 0 И ИзмененияТаблиц.Количество() = 0 И Действие = "update"
			И Данные.Получить("post") = Неопределено Тогда
			ВызватьОшибку("VALIDATION", "Нечего менять: значения совпадают с текущими");
		КонецЕсли;
		Попытка
			Объект.ПроверитьЗаполнение();
		Исключение
			Предупреждения.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Предупреждения.Добавить(Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;

	Провести = Ложь;
	Пост = Данные.Получить("post");
	Если ЭтоДокумент И (Действие = "create" Или Действие = "update") Тогда
		Провести = ?(ТипЗнч(Пост) = Тип("Булево"), Пост, БылПроведен);
	КонецЕсли;

	Описание = ОписаниеСостояния(Объект, МД);
	Описание.Вставить("action", Действие);
	Описание.Вставить("version", Версия);
	Описание.Вставить("willPost", Провести);
	Описание.Вставить("changes", Изменения);
	Описание.Вставить("tables", ИзмененияТаблиц);
	Описание.Вставить("warnings", Предупреждения);
	Возврат Новый Структура("Объект, МД, ЭтоДокумент, Провести, Описание", Объект, МД, ЭтоДокумент, Провести, Описание);
КонецФункции

Процедура ЗаписатьИзменение(Изменение)
	Объект = Изменение.Объект;
	Действие = Изменение.Описание.action;
	Если Изменение.ЭтоДокумент Тогда
		ПроверитьДатуЗапрета(Объект);
	КонецЕсли;
	Если Действие = "delete" Или Действие = "undelete" Тогда
		Объект.УстановитьПометкуУдаления(Действие = "delete"); // у документа пометка снимает проведение
	ИначеЕсли Не Изменение.ЭтоДокумент Тогда
		Объект.Записать();
	ИначеЕсли Изменение.Провести Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	ИначеЕсли Объект.Проведен Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

// Документы и справочники; остальное (регистры, планы счетов) меняется только через документы.
Функция ОбъектМетаданныхДляИзменения(ПолноеИмя)
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МД = Неопределено Тогда
		ВызватьОшибку("VALIDATION", "В конфигурации нет объекта " + ПолноеИмя);
	КонецЕсли;
	Если Не Метаданные.Документы.Содержит(МД) И Не Метаданные.Справочники.Содержит(МД) Тогда
		ВызватьОшибку("VALIDATION", "Менять можно только документы и справочники, а не " + ПолноеИмя);
	КонецЕсли;
	Возврат МД;
КонецФункции

Функция СсылкаОбъекта(МД, ИД)
	Менеджер = ?(Метаданные.Документы.Содержит(МД), Документы[МД.Имя], Справочники[МД.Имя]);
	Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(ИД)), "NOT_FOUND", МД.ПолноеИмя() + " " + ИД + " не найден");
КонецФункции

Функция ОписаниеСостояния(Объект, МД)
	ЭтоДокумент = Метаданные.Документы.Содержит(МД);
	Результат = Новый Структура;
	Результат.Вставить("object", МД.ПолноеИмя());
	Результат.Вставить("ref", ?(Объект.ЭтоНовый(), Неопределено, УИД(Объект.Ссылка)));
	Результат.Вставить("presentation", ?(Объект.ЭтоНовый(), ПредставлениеНового(Объект, МД, ЭтоДокумент), Строка(Объект.Ссылка)));
	Результат.Вставить("posted", ЭтоДокумент И Объект.Проведен);
	Результат.Вставить("deletionMark", Объект.ПометкаУдаления);
	Результат.Вставить("version", ?(Объект.ЭтоНовый(), "", Строка(Объект.ВерсияДанных)));
	Возврат Результат;
КонецФункции

Функция ПредставлениеНового(Объект, МД, ЭтоДокумент)
	Если ЭтоДокумент Тогда
		Возврат МД.Представление() + " (новый) от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат МД.Представление() + ": " + Объект.Наименование;
КонецФункции

Процедура УстановитьПоле(Объект, МД, Имя, Значение, Изменения)
	Если Имя = "Ссылка" Или Имя = "ПометкаУдаления" Или Имя = "Проведен" Или Имя = "ВерсияДанных"
		Или Имя = "Предопределенный" Или Имя = "ИмяПредопределенныхДанных" Или Имя = "ЭтоГруппа" Тогда
		ВызватьОшибку("VALIDATION", "Поле " + Имя + " так не меняется: для удаления — action delete, для проведения — post");
	КонецЕсли;
	ОписаниеТипов = ТипПоля(МД, Имя);
	Если ОписаниеТипов = Неопределено Тогда
		ВызватьОшибку("VALIDATION", "У " + МД.ПолноеИмя() + " нет поля " + Имя + ": проверьте имена через describe_objects");
	КонецЕсли;
	Новое = ЗначениеПоля(Значение, ОписаниеТипов, Имя);
	Старое = Объект[Имя];
	Если Старое <> Новое Тогда
		Изменения.Добавить(Новый Структура("field, before, after", Имя, ПредставлениеЗначения(Старое), ПредставлениеЗначения(Новое)));
		Объект[Имя] = Новое;
	КонецЕсли;
КонецПроцедуры

Функция ТипПоля(МД, Имя)
	Реквизит = МД.Реквизиты.Найти(Имя);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит.Тип;
	КонецЕсли;
	Для Каждого СР Из МД.СтандартныеРеквизиты Цикл
		Если СР.Имя = Имя Тогда
			Возврат СР.Тип;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура ЗаменитьТаблицу(Объект, МД, ИмяТаблицы, Строки, ИзмененияТаблиц)
	МДТЧ = МД.ТабличныеЧасти.Найти(ИмяТаблицы);
	Если МДТЧ = Неопределено Тогда
		ВызватьОшибку("VALIDATION", "У " + МД.ПолноеИмя() + " нет табличной части " + ИмяТаблицы);
	КонецЕсли;
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		ВызватьОшибку("VALIDATION", "tables." + ИмяТаблицы + " должна быть массивом строк");
	КонецЕсли;
	ТабличнаяЧасть = Объект[ИмяТаблицы];
	БылоСтрок = ТабличнаяЧасть.Количество();
	ТабличнаяЧасть.Очистить();
	Для Каждого ДанныеСтроки Из Строки Цикл
		Если ТипЗнч(ДанныеСтроки) <> Тип("Соответствие") Тогда
			ВызватьОшибку("VALIDATION", "Строка tables." + ИмяТаблицы + " должна быть объектом");
		КонецЕсли;
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		Для Каждого Поле Из ДанныеСтроки Цикл
			Колонка = МДТЧ.Реквизиты.Найти(Поле.Ключ);
			Если Колонка = Неопределено Тогда
				ВызватьОшибку("VALIDATION", "В " + ИмяТаблицы + " нет колонки " + Поле.Ключ);
			КонецЕсли;
			НоваяСтрока[Поле.Ключ] = ЗначениеПоля(Поле.Значение, Колонка.Тип, ИмяТаблицы + "." + Поле.Ключ);
		КонецЦикла;
	КонецЦикла;
	СтрокиПосле = Новый Массив;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если СтрокиПосле.Количество() = 50 Тогда
			Прервать;
		КонецЕсли;
		Колонки = Новый Соответствие;
		Для Каждого Колонка Из МДТЧ.Реквизиты Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ[Колонка.Имя]) Тогда
				Колонки.Вставить(Колонка.Имя, ПредставлениеЗначения(СтрокаТЧ[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		СтрокиПосле.Добавить(Колонки);
	КонецЦикла;
	ИзмененияТаблиц.Добавить(Новый Структура("table, rowsBefore, rowsAfter, rows", ИмяТаблицы, БылоСтрок,
		ТабличнаяЧасть.Количество(), СтрокиПосле));
КонецПроцедуры

// Значение из JSON в значение реквизита с типом ОписаниеТипов.
Функция ЗначениеПоля(Значение, ОписаниеТипов, Имя)
	Если Значение = Неопределено Тогда
		Возврат ОписаниеТипов.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СсылкаИзОписания(Значение, ОписаниеТипов, Имя);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Для Каждого ТипПоля Из ОписаниеТипов.Типы() Цикл
			МДТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Если МДТипа <> Неопределено И Метаданные.Перечисления.Содержит(МДТипа)
				И МДТипа.ЗначенияПеречисления.Найти(Значение) <> Неопределено Тогда
				Возврат Перечисления[МДТипа.Имя][Значение];
			КонецЕсли;
		КонецЦикла;
		Если ОписаниеТипов.СодержитТип(Тип("Дата")) И СтрДлина(Значение) >= 10 И Сред(Значение, 5, 1) = "-" Тогда
			Возврат ДатаИзСтроки(Значение);
		КонецЕсли;
		Если Не ОписаниеТипов.СодержитТип(Тип("Строка")) И ЕстьСсылочныйТип(ОписаниеТипов) Тогда
			Поиск = Новый Соответствие;
			Поиск.Вставить("name", Значение);
			Возврат СсылкаИзОписания(Поиск, ОписаниеТипов, Имя);
		КонецЕсли;
	КонецЕсли;
	Результат = ОписаниеТипов.ПривестиЗначение(Значение);
	Если ЗначениеЗаполнено(Значение) И Не ЗначениеЗаполнено(Результат) Тогда
		ВызватьОшибку("VALIDATION", "Значение " + Строка(Значение) + " не подходит к полю " + Имя);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЕстьСсылочныйТип(ОписаниеТипов)
	Для Каждого ТипПоля Из ОписаниеТипов.Типы() Цикл
		Если Метаданные.НайтиПоТипу(ТипПоля) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// {"type"?, "ref"} | {"type"?, "find": {поле: значение}} | {"type"?, "name"} | {"type"?, "code"} -> ссылка.
Функция СсылкаИзОписания(Описание, ОписаниеТипов, Имя)
	ИмяТипа = Описание.Получить("type");
	Кандидаты = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТипов.Типы() Цикл
		МДТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МДТипа <> Неопределено И (Не ЗначениеЗаполнено(ИмяТипа) Или МДТипа.ПолноеИмя() = ИмяТипа) Тогда
			Кандидаты.Добавить(МДТипа);
		КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() = 0 Тогда
		ВызватьОшибку("VALIDATION", "Поле " + Имя + " не принимает ссылку" + ?(ЗначениеЗаполнено(ИмяТипа), " на " + ИмяТипа, ""));
	ИначеЕсли Кандидаты.Количество() > 1 Тогда
		Имена = Новый Массив;
		Для Каждого Кандидат Из Кандидаты Цикл
			Имена.Добавить(Кандидат.ПолноеИмя());
		КонецЦикла;
		ВызватьОшибку("VALIDATION", "Поле " + Имя + " допускает несколько типов: укажите type (" + СтрСоединить(Имена, ", ") + ")");
	КонецЕсли;
	МДТипа = Кандидаты[0];
	ПолноеИмя = МДТипа.ПолноеИмя();

	Если Метаданные.Перечисления.Содержит(МДТипа) Тогда
		ИмяЗначения = ?(ЗначениеЗаполнено(Описание.Получить("ref")), Описание.Получить("ref"), Описание.Получить("value"));
		Если МДТипа.ЗначенияПеречисления.Найти(Строка(ИмяЗначения)) = Неопределено Тогда
			ВызватьОшибку("VALIDATION", "В " + ПолноеИмя + " нет значения " + Строка(ИмяЗначения));
		КонецЕсли;
		Возврат Перечисления[МДТипа.Имя][Строка(ИмяЗначения)];
	КонецЕсли;

	Менеджер = МенеджерОбъекта(МДТипа);
	Если ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "NOT_FOUND",
			ПолноеИмя + " " + Описание.Получить("ref") + " не найден");
	КонецЕсли;
	Поиск = Описание.Получить("find");
	Если ТипЗнч(Поиск) <> Тип("Соответствие") Тогда
		Поиск = Новый Соответствие;
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Получить("name")) Тогда
		Поиск.Вставить("Наименование", Описание.Получить("name"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Получить("code")) Тогда
		Поиск.Вставить("Код", Описание.Получить("code"));
	КонецЕсли;
	Если Поиск.Количество() = 0 Тогда
		ВызватьОшибку("VALIDATION", "Для поля " + Имя + " укажите ref, find, name или code");
	КонецЕсли;
	Условия = Новый Массив;
	Запрос = Новый Запрос;
	Номер = 0;
	Для Каждого Условие Из Поиск Цикл
		Номер = Номер + 1;
		Условия.Добавить(СтрШаблон("Т.%1 = &П%2", Условие.Ключ, Номер));
		Запрос.УстановитьПараметр("П" + Номер, ЗначениеПараметраЗапроса(Условие.Значение));
	КонецЦикла;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И %2", ПолноеИмя, СтрСоединить(Условия, " И "));
	Попытка
		Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		ВызватьОшибку("VALIDATION", "Поиск в " + ПолноеИмя + " не удался: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Ссылки.Количество() = 1 Тогда
		Возврат Ссылки[0];
	КонецЕсли;
	ВызватьОшибку(?(Ссылки.Количество() = 0, "NOT_FOUND", "VALIDATION"),
		?(Ссылки.Количество() = 0, "В " + ПолноеИмя + " не найдено: ", "В " + ПолноеИмя + " несколько подходящих: ")
		+ ВJSON(Поиск) + " (поле " + Имя + ")");
КонецФункции

Функция МенеджерОбъекта(МДТипа)
	Если Метаданные.Справочники.Содержит(МДТипа) Тогда
		Возврат Справочники[МДТипа.Имя];
	ИначеЕсли Метаданные.Документы.Содержит(МДТипа) Тогда
		Возврат Документы[МДТипа.Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МДТипа) Тогда
		Возврат ПланыСчетов[МДТипа.Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МДТипа) Тогда
		Возврат ПланыВидовХарактеристик[МДТипа.Имя];
	КонецЕсли;
	ВызватьОшибку("VALIDATION", "Ссылки на " + МДТипа.ПолноеИмя() + " так не задаются");
КонецФункции

Функция ПредставлениеЗначения(Значение)
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ДатаВСтроку(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

#КонецОбласти

#Область СчетФактураВыданный

Функция СоздатьСчетФактуруВыданный(Данные)
	Имена = PlatformAPI_Map.СчетФактураВыданный();
	Реализация = НайтиРеализацию(Обязательно(Данные, "sale"), Имена);
	Существующий = СчетФактураПоРеализации(Реализация, Имена);
	Если Существующий <> Неопределено Тогда
		Возврат ОписаниеРезультата(Существующий, Истина);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		PlatformAPI_Log.Заблокировать();
		Существующий = СчетФактураПоРеализации(Реализация, Имена);
		Если Существующий <> Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат ОписаниеРезультата(Существующий, Истина);
		КонецЕсли;

		Документ = Документы[Имена.Документ].СоздатьДокумент();
		Документ.Заполнить(Реализация); // заполнение «на основании» средствами самой конфигурации
		Если Не ЗначениеЗаполнено(Документ.Дата) Тогда
			Документ.Дата = Реализация.Дата;
		КонецЕсли;
		МД = Метаданные.Документы[Имена.Документ];
		Комментарий = "PlatformAPI: на основании " + Строка(Реализация);
		Если МД.Реквизиты.Найти("Комментарий") <> Неопределено И Не ЗначениеЗаполнено(Документ.Комментарий) Тогда
			Документ.Комментарий = Комментарий;
		КонецЕсли;

		ПроверитьДатуЗапрета(Документ);
		Документ.Записать(РежимЗаписиДокумента.Запись); // без проведения
		PlatformAPI_Log.Записать("sale", УИД(Реализация), Документ.Ссылка, "CreateInvoiceIssued");
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ОписаниеРезультата(Документ.Ссылка, Ложь);
КонецФункции

// Реализация по ref или по номеру и дате. Номер можно дать без префикса и нулей («123» для
// «0000-000123»), если такой номер за этот день один.
Функция НайтиРеализацию(Описание, Имена)
	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		ВызватьОшибку("VALIDATION", "sale должен быть объектом");
	КонецЕсли;
	Менеджер = Документы[Имена.Реализация];
	Если ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "SALE_NOT_FOUND",
			"Реализация не найдена");
	КонецЕсли;
	Номер = СокрЛП(Строка(Обязательно(Описание, "number")));
	День = ДатаИзСтроки(Обязательно(Описание, "date"));
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Р.Ссылка КАК Ссылка,
	|	Р.Номер КАК Номер
	|ИЗ
	|	Документ.%1 КАК Р
	|ГДЕ
	|	Р.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ Р.ПометкаУдаления
	|	И (Р.Номер = &Номер ИЛИ Р.Номер ПОДОБНО &Окончание)", Имена.Реализация));
	Запрос.УстановитьПараметр("Начало", НачалоДня(День));
	Запрос.УстановитьПараметр("Конец", КонецДня(День));
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Окончание", "%" + Номер);
	Таблица = Запрос.Выполнить().Выгрузить();
	Точная = Таблица.Найти(Номер, "Номер");
	Если Точная <> Неопределено Тогда
		Возврат Точная.Ссылка;
	КонецЕсли;
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].Ссылка;
	КонецЕсли;
	ВызватьОшибку("SALE_NOT_FOUND",
		?(Таблица.Количество() = 0, "Реализация № " + Номер + " за " + Формат(День, "ДФ=dd.MM.yyyy") + " не найдена",
			"Номер " + Номер + " подходит к нескольким реализациям за этот день: укажите полный номер"),
		Новый Структура("number, date", Номер, Описание.Получить("date")));
КонецФункции

// Счёт-фактура, уже выписанный на эту реализацию: приложением (журнал) или вручную (основание).
Функция СчетФактураПоРеализации(Реализация, Имена)
	Найден = PlatformAPI_Log.НайтиДокумент("sale", УИД(Реализация), Имена.Документ);
	Если Найден <> Неопределено Тогда
		Возврат Найден;
	КонецЕсли;
	МД = Метаданные.Документы[Имена.Документ];
	Если МД.Реквизиты.Найти(Имена.Основание) <> Неопределено Тогда
		Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Д.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.%1 КАК Д
		|ГДЕ
		|	Д.%2 = &Реализация
		|	И НЕ Д.ПометкаУдаления", Имена.Документ, Имена.Основание);
	ИначеЕсли МД.ТабличныеЧасти.Найти(Имена.ТаблицаОснований) <> Неопределено
		И МД.ТабличныеЧасти[Имена.ТаблицаОснований].Реквизиты.Найти(Имена.Основание) <> Неопределено Тогда
		Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.%1.%2 КАК Т
		|ГДЕ
		|	Т.%3 = &Реализация
		|	И НЕ Т.Ссылка.ПометкаУдаления", Имена.Документ, Имена.ТаблицаОснований, Имена.Основание);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция ОписаниеРеализации(Реализация, Имена)
	МД = Метаданные.Документы[Имена.Реализация];
	Объект = Реализация.ПолучитьОбъект();
	Результат = Новый Структура;
	Результат.Вставить("ref", УИД(Реализация));
	Результат.Вставить("number", СокрЛП(Объект.Номер));
	Результат.Вставить("date", ДатаВСтроку(Объект.Дата));
	Результат.Вставить("organization", ПредставлениеРеквизита(Объект, МД, Имена.Организация));
	Результат.Вставить("counterparty", ПредставлениеРеквизита(Объект, МД, Имена.Контрагент));
	Сумма = Неопределено;
	Если МД.Реквизиты.Найти(Имена.СуммаДокумента) <> Неопределено Тогда
		Сумма = Объект[Имена.СуммаДокумента];
	КонецЕсли;
	Результат.Вставить("amount", Сумма);
	Результат.Вставить("posted", Объект.Проведен);
	Возврат Результат;
КонецФункции

Функция ПредставлениеРеквизита(Объект, МД, Имя)
	Если МД.Реквизиты.Найти(Имя) = Неопределено Или Не ЗначениеЗаполнено(Объект[Имя]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Объект[Имя]);
КонецФункции

Функция ОписаниеДокумента(Ссылка)
	Возврат Новый Структура("ref, number, date", УИД(Ссылка), СокрЛП(Ссылка.Номер), ДатаВСтроку(Ссылка.Дата));
КонецФункции

#КонецОбласти

#Область СчетФактураПолученный

Функция СоздатьСчетФактуруПолученный(Данные)
	Имена = PlatformAPI_Map.СчетФактураПолученный();
	ВнешнийИД = Строка(Обязательно(Данные, "externalId"));
	Источник = Строка(Обязательно(Данные, "source"));
	Строки = Данные.Получить("lines");
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		ВызватьОшибку("VALIDATION", "Нужна хотя бы одна строка (lines)");
	КонецЕсли;

	// Повторный импорт того же документа ничего не создаёт.
	Существующий = PlatformAPI_Log.НайтиДокумент(Источник, ВнешнийИД, Имена.Документ);
	Если Существующий <> Неопределено Тогда
		Возврат ОписаниеРезультата(Существующий, Истина);
	КонецЕсли;

	Организация = НайтиОрганизацию(Данные.Получить("organization"));
	Контрагент = НайтиКонтрагента(Обязательно(Данные, "counterparty"));
	Договор = НайтиДоговор(Данные.Получить("contract"), Контрагент, Имена.Документ);
	ДатаДокумента = ДатаИзСтроки(Обязательно(Данные, "date"));

	МД = Метаданные.Документы[Имена.Документ];
	МДТаблицы = МД.ТабличныеЧасти[Имена.Товары];

	НачатьТранзакцию();
	Попытка
		// Параллельный импорт того же документа: блокировка журнала делает записи по очереди,
		// поэтому повторная проверка ExternalID внутри транзакции надёжна.
		PlatformAPI_Log.Заблокировать();
		Существующий = PlatformAPI_Log.НайтиДокумент(Источник, ВнешнийИД, Имена.Документ);
		Если Существующий <> Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат ОписаниеРезультата(Существующий, Истина);
		КонецЕсли;

		Документ = Документы[Имена.Документ].СоздатьДокумент();
		Документ.Дата = ДатаДокумента + 12 * 3600;
		УстановитьЕслиЕсть(Документ, МД, "ExternalID", ВнешнийИД); // если реквизит добавлен заимствованием
		УстановитьЕслиЕсть(Документ, МД, Имена.Организация, Организация);
		УстановитьЕслиЕсть(Документ, МД, Имена.Контрагент, Контрагент);
		УстановитьЕслиЕсть(Документ, МД, Имена.Договор, Договор);
		УстановитьЕслиЕсть(Документ, МД, Имена.НомерВходящего, Строка(Обязательно(Данные, "number")));
		УстановитьЕслиЕсть(Документ, МД, Имена.ДатаВходящего, ДатаДокумента);
		УстановитьЕслиЕсть(Документ, МД, Имена.СуммаВключаетНДС, Ложь); // суммы строк приходят без НДС
		Комментарий = Данные.Получить("comment");
		УстановитьЕслиЕсть(Документ, МД, "Комментарий", СтрШаблон("PlatformAPI: %1 %2%3", Источник, ВнешнийИД,
			?(ЗначениеЗаполнено(Комментарий), ". " + Комментарий, "")));

		Итого = 0;
		Номер = 0;
		Для Каждого ДанныеСтроки Из Строки Цикл
			Номер = Номер + 1;
			СтрокаТЧ = Документ[Имена.Товары].Добавить();
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.Номенклатура, НайтиНоменклатуру(ДанныеСтроки.Получить("item"), Номер));
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.Количество, Число(ДанныеСтроки.Получить("quantity")));
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.Цена, Число(ДанныеСтроки.Получить("price")));
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.Сумма, Число(ДанныеСтроки.Получить("amount")));
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.СуммаНДС, Число(ДанныеСтроки.Получить("vatAmount")));
			Если МДТаблицы.Реквизиты.Найти(Имена.СтавкаНДС) <> Неопределено Тогда
				СтрокаТЧ[Имена.СтавкаНДС] = СтавкаНДС(Число(ДанныеСтроки.Получить("vatRate")), МДТаблицы.Реквизиты[Имена.СтавкаНДС].Тип, Номер);
			КонецЕсли;
			УстановитьЕслиЕсть(СтрокаТЧ, МДТаблицы, Имена.Всего, Число(ДанныеСтроки.Получить("total")));
			Итого = Итого + Число(ДанныеСтроки.Получить("total"));
		КонецЦикла;
		УстановитьЕслиЕсть(Документ, МД, Имена.СуммаДокумента, Итого);

		ПроверитьДатуЗапрета(Документ);
		Документ.Записать(РежимЗаписиДокумента.Запись); // без проведения
		PlatformAPI_Log.Записать(Источник, ВнешнийИД, Документ.Ссылка, "CreateInvoiceReceived");
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ОписаниеРезультата(Документ.Ссылка, Ложь);
КонецФункции

Функция ОписаниеРезультата(Ссылка, ЭтоПовтор)
	Результат = Новый Структура;
	Результат.Вставить("ref", УИД(Ссылка));
	Результат.Вставить("number", СокрЛП(Ссылка.Номер));
	Результат.Вставить("date", ДатаВСтроку(Ссылка.Дата));
	Результат.Вставить("posted", Ложь);
	Результат.Вставить("duplicate", ЭтоПовтор);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПоискСсылок

Функция НайтиОрганизацию(Описание)
	Имена = PlatformAPI_Map.Организации();
	Менеджер = Справочники[Имена.Справочник];
	Если ТипЗнч(Описание) = Тип("Соответствие") И ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "ORGANIZATION_NOT_FOUND", "Организация не найдена");
	КонецЕсли;
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И (&ИНН = """" ИЛИ Т.%2 = &ИНН)", Имена.Справочник, Имена.ИНН));
	ИНН = "";
	Если ТипЗнч(Описание) = Тип("Соответствие") И ЗначениеЗаполнено(Описание.Получить("inn")) Тогда
		ИНН = Описание.Получить("inn");
	КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Ссылки.Количество() = 1 Тогда
		Возврат Ссылки[0];
	КонецЕсли;
	ВызватьОшибку("ORGANIZATION_NOT_FOUND",
		?(Ссылки.Количество() = 0, "Организация не найдена", "В базе несколько организаций: укажите organization.ref или inn"),
		Новый Структура("inn", ИНН));
КонецФункции

Функция НайтиКонтрагента(Описание)
	Имена = PlatformAPI_Map.Контрагенты();
	Менеджер = Справочники[Имена.Справочник];
	Если ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "COUNTERPARTY_NOT_FOUND", "Контрагент не найден");
	КонецЕсли;
	ИНН = Строка(Описание.Получить("inn"));
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.%2 = &ИНН
	|	И НЕ Т.ПометкаУдаления
	|	И НЕ Т.ЭтоГруппа", Имена.Справочник, Имена.ИНН));
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьОшибку("COUNTERPARTY_NOT_FOUND", "Контрагент с ИНН " + ИНН + " не найден", Новый Структура("inn", ИНН));
КонецФункции

// Договор: переданный (должен принадлежать контрагенту) или единственный договор контрагента.
Функция НайтиДоговор(Описание, Контрагент, ИмяДокумента)
	Имена = PlatformAPI_Map.Договоры();
	Менеджер = Справочники[Имена.Справочник];
	Если ТипЗнч(Описание) = Тип("Соответствие") И ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Договор = Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "CONTRACT_NOT_FOUND", "Договор не найден");
		Если Договор[Имена.Владелец] <> Контрагент Тогда
			ВызватьОшибку("CONTRACT_NOT_FOUND", "Договор принадлежит другому контрагенту");
		КонецЕсли;
		Возврат Договор;
	КонецЕсли;
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.%2 = &Контрагент
	|	И НЕ Т.ПометкаУдаления", Имена.Справочник, Имена.Владелец));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат ?(Ссылки.Количество() = 1, Ссылки[0], Неопределено); // несколько договоров — выбор в приложении (фаза 1)
КонецФункции

Функция НайтиНоменклатуру(Описание, НомерСтроки)
	Имена = PlatformAPI_Map.Номенклатура();
	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		ВызватьОшибку("VALIDATION", "Строка " + НомерСтроки + ": нужен item");
	КонецЕсли;
	Менеджер = Справочники[Имена.Справочник];
	Если ЗначениеЗаполнено(Описание.Получить("ref")) Тогда
		Возврат Существующая(Менеджер.ПолучитьСсылку(УИДИзСтроки(Описание.Получить("ref"))), "ITEM_NOT_FOUND",
			"Номенклатура строки " + НомерСтроки + " не найдена", Новый Структура("line", НомерСтроки));
	КонецЕсли;
	МД = Метаданные.Справочники[Имена.Справочник];
	Если ЗначениеЗаполнено(Описание.Получить("ikpu")) И МД.Реквизиты.Найти(Имена.ИКПУ) <> Неопределено Тогда
		Найдено = НайтиПоПолю(Имена.Справочник, Имена.ИКПУ, Описание.Получить("ikpu"));
		Если Найдено <> Неопределено Тогда
			Возврат Найдено;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Получить("name")) Тогда
		Найдено = НайтиПоПолю(Имена.Справочник, "Наименование", Описание.Получить("name"));
		Если Найдено <> Неопределено Тогда
			Возврат Найдено;
		КонецЕсли;
	КонецЕсли;
	ВызватьОшибку("ITEM_NOT_FOUND", "Номенклатура строки " + НомерСтроки + " не найдена",
		Новый Структура("line, ikpu, name", НомерСтроки, Описание.Получить("ikpu"), Описание.Получить("name")));
КонецФункции

Функция НайтиПоПолю(ИмяСправочника, Поле, Значение)
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.%2 = &Значение
	|	И НЕ Т.ПометкаУдаления
	|	И НЕ Т.ЭтоГруппа", ИмяСправочника, Поле));
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция Существующая(Ссылка, Код, Сообщение, Детали = Неопределено)
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(Код, Сообщение, Детали);
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

// Ставка НДС в виде, который хранит реквизит: число, значение перечисления (НДС12, БезНДС) или элемент справочника.
Функция СтавкаНДС(Процент, ОписаниеТипов, НомерСтроки)
	Если ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Возврат Процент;
	КонецЕсли;
	Для Каждого ТипСтавки Из ОписаниеТипов.Типы() Цикл
		МДСтавки = Метаданные.НайтиПоТипу(ТипСтавки);
		Если МДСтавки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Перечисления.Содержит(МДСтавки) Тогда
			Менеджер = Перечисления[МДСтавки.Имя];
			Для Каждого Значение Из МДСтавки.ЗначенияПеречисления Цикл
				Если ПроцентСтавки(Значение.Имя) = Процент Тогда
					Возврат Менеджер[Значение.Имя];
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли Метаданные.Справочники.Содержит(МДСтавки) И МДСтавки.Реквизиты.Найти("Ставка") <> Неопределено Тогда
			Ссылка = Справочники[МДСтавки.Имя].НайтиПоРеквизиту("Ставка", Процент);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Возврат Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ВызватьОшибку("VAT_RATE_NOT_FOUND", "Строка " + НомерСтроки + ": нет ставки НДС " + Процент + "%",
		Новый Структура("line, vatRate", НомерСтроки, Процент));
КонецФункции

// "НДС12" -> 12; "БезНДС" -> 0.
Функция ПроцентСтавки(ИмяЗначения)
	Цифры = "";
	Для Индекс = 1 По СтрДлина(ИмяЗначения) Цикл
		Знак = Сред(ИмяЗначения, Индекс, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Цифры = Цифры + Знак;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Цифры = "", 0, Число(Цифры));
КонецФункции

#КонецОбласти

#Область Служебные

Функция ОписаниеОбъекта(МД)
	Результат = Новый Структура;
	Результат.Вставить("fullName", МД.ПолноеИмя());
	Результат.Вставить("synonym", МД.Синоним);
	Реквизиты = ОписаниеПолей(МД.СтандартныеРеквизиты);
	Для Каждого Поле Из ОписаниеПолей(МД.Реквизиты) Цикл
		Реквизиты.Добавить(Поле);
	КонецЦикла;
	Результат.Вставить("attributes", Реквизиты);
	Таблицы = Новый Массив;
	Если ЕстьСвойство(МД, "ТабличныеЧасти") Тогда
		Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
			Таблицы.Добавить(Новый Структура("name, synonym, attributes", ТЧ.Имя, ТЧ.Синоним, ОписаниеПолей(ТЧ.Реквизиты)));
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("tabularSections", Таблицы);
	Возврат Результат;
КонецФункции

Функция ОписаниеПолей(Коллекция)
	Результат = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Типы = Новый Массив;
		Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
			МДТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Типы.Добавить(?(МДТипа = Неопределено, Строка(ТипПоля), МДТипа.ПолноеИмя()));
		КонецЦикла;
		Результат.Добавить(Новый Структура("name, synonym, types", Поле.Имя, Поле.Синоним, Типы));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЕстьСвойство(Объект, Имя)
	Проверка = Новый Структура(Имя, NULL);
	ЗаполнитьЗначенияСвойств(Проверка, Объект);
	Возврат Проверка[Имя] <> NULL;
КонецФункции

Процедура УстановитьЕслиЕсть(Объект, МетаданныеОбъекта, Имя, Значение)
	Если ЗначениеЗаполнено(Имя) И МетаданныеОбъекта.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Объект[Имя] = Значение;
	КонецЕсли;
КонецПроцедуры

// Дата запрета изменения (БСП): если подсистемы нет, проверку выполнит сама запись.
// Модуль БСП берётся по имени, чтобы расширение компилировалось и в базе без него.
Процедура ПроверитьДатуЗапрета(Документ)
	Запрещено = Ложь;
	Если Метаданные.ОбщиеМодули.Найти("ДатыЗапретаИзменения") <> Неопределено Тогда
		Попытка
			МодульДатЗапрета = Вычислить("ДатыЗапретаИзменения");
			Запрещено = МодульДатЗапрета.ИзменениеЗапрещено(Документ) = Истина;
		Исключение
			Запрещено = Ложь;
		КонецПопытки;
	КонецЕсли;
	Если Запрещено Тогда
		ВызватьОшибку("CLOSED_PERIOD", "Период закрыт (дата запрета изменения)");
	КонецЕсли;
КонецПроцедуры

Функция Обязательно(Данные, Ключ)
	Значение = Данные.Получить(Ключ);
	Если Значение = Неопределено Или (ТипЗнч(Значение) = Тип("Строка") И Не ЗначениеЗаполнено(Значение)) Тогда
		ВызватьОшибку("VALIDATION", "Не заполнено поле " + Ключ, Новый Структура("field", Ключ));
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция УИД(Ссылка)
	Возврат ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка.УникальныйИдентификатор()), Неопределено);
КонецФункции

Функция УИДИзСтроки(Значение)
	Попытка
		Возврат Новый УникальныйИдентификатор(Значение);
	Исключение
		ВызватьОшибку("VALIDATION", "Неверный ref: " + Значение);
	КонецПопытки;
КонецФункции

// "2026-10-01" или "2026-10-01T10:00:00" -> Дата
Функция ДатаИзСтроки(Значение)
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Значение, 19), "-", ""), ":", ""), "T", "");
	Если СтрДлина(Текст) = 8 Тогда
		Текст = Текст + "000000";
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
		ВызватьОшибку("VALIDATION", "Неверная дата: " + Значение);
	КонецПопытки;
КонецФункции

// Дата -> "yyyy-MM-ddTHH:mm:ss"; пустая дата -> Неопределено (null).
Функция ДатаВСтроку(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");
КонецФункции

Функция ЗначениеПараметраЗапроса(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) >= 10
		И Сред(Значение, 5, 1) = "-" И Сред(Значение, 8, 1) = "-" Тогда
		Попытка
			Возврат ДатаИзСтроки(Значение);
		Исключение
			Возврат Значение; // не дата
		КонецПопытки;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Значение поля -> то, что можно записать в JSON. Ссылки и перечисления — представлением, а при
// СоСсылками — объектом {type: полное имя, ref: УИД (у перечисления — имя значения), name}.
Функция ЗначениеВJSON(Значение, СоСсылками = Ложь)
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ДатаВСтроку(Значение);
	КонецЕсли;
	Если СоСсылками Тогда
		МДТипа = Метаданные.НайтиПоТипу(ТипЗначения);
		Если МДТипа <> Неопределено Тогда
			Если Не ЗначениеЗаполнено(Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Новый Структура("type, ref, name", МДТипа.ПолноеИмя(), XMLСтрока(Значение), Строка(Значение));
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(Значение); // ссылки, перечисления, счета — представлением
КонецФункции

#КонецОбласти

#Область JSON

Функция ПрочитатьВход(Текст)
	Если ТипЗнч(Текст) <> Тип("Строка") Или Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьОшибку("BAD_JSON", "Ожидалась строка JSON");
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ВызватьОшибку("BAD_JSON", "Аргумент не является JSON");
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьОшибку("BAD_JSON", "Ожидался объект JSON");
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция Успех(Данные)
	Возврат ВJSON(Новый Структура("ok, data", Истина, Данные));
КонецФункции

// Ошибка с кодом из контракта. Детали передаются в тексте исключения как JSON после маркера.
Процедура ВызватьОшибку(Код, Сообщение, Детали = Неопределено)
	ВызватьИсключение СтрШаблон("[PlatformAPI:%1]%2[details]%3", Код, Сообщение,
		?(Детали = Неопределено, "", ВJSON(Детали)));
КонецПроцедуры

Функция ОшибкаИзИсключения(Информация)
	Текст = КраткоеПредставлениеОшибки(Информация);
	Код = "INTERNAL";
	Сообщение = Текст;
	Детали = Новый Структура;
	Начало = СтрНайти(Текст, "[PlatformAPI:");
	Если Начало > 0 Тогда
		Конец = СтрНайти(Текст, "]", , Начало);
		Код = Сред(Текст, Начало + 13, Конец - Начало - 13);
		Остаток = Сред(Текст, Конец + 1);
		Разделитель = СтрНайти(Остаток, "[details]");
		Сообщение = ?(Разделитель > 0, Лев(Остаток, Разделитель - 1), Остаток);
		ДеталиJSON = ?(Разделитель > 0, Сред(Остаток, Разделитель + 9), "");
		Если ЗначениеЗаполнено(ДеталиJSON) Тогда
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(ДеталиJSON);
				Детали = ПрочитатьJSON(Чтение);
			Исключение
				Детали = Новый Структура;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли СтрНайти(НРег(Текст), "запрет") > 0 И СтрНайти(НРег(Текст), "дат") > 0 Тогда
		Код = "CLOSED_PERIOD";
	ИначеЕсли ТранзакцияАктивна() Или СтрНайти(НРег(Текст), "запис") > 0 Тогда
		Код = "WRITE_FAILED";
	КонецЕсли;
	Если Код = "INTERNAL" Или Код = "WRITE_FAILED" Тогда
		Детали.Вставить("onec", ПодробноеПредставлениеОшибки(Информация));
		ЗаписьЖурналаРегистрации("PlatformAPI", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецЕсли;
	Ошибка = Новый Структура("code, message, details", Код, СокрЛП(Сообщение), Детали);
	Возврат ВJSON(Новый Структура("ok, error", Ложь, Ошибка));
КонецФункции

#КонецОбласти
