// Общий модуль PlatformAPI_Log (Сервер ✔, Внешнее соединение ✔).
// Журнал записей приложения: один элемент справочника PlatformLog на каждую запись в базу.
// Он же — индекс ExternalID: по нему повторный импорт находит уже созданный документ.
// Вызывается только из PlatformAPI внутри той же транзакции, что и сама запись.
//
// Привилегированные модули в расширении запрещены, поэтому журнал включает привилегированный режим
// сам, на время своей процедуры: так он ведётся и читается при любых правах пользователя 1С, и
// отдельная роль не нужна. Это работает, когда у расширения выключен безопасный режим; иначе
// действуют права пользователя, под которым подключилось приложение.
// Ссылка на документ хранится как его вид и УИД: тип «любой документ» в расширении недопустим.

#Область ПрограммныйИнтерфейс

// Исключительная управляемая блокировка всего журнала до конца транзакции. Журнал пишет только
// PlatformAPI, поэтому записи приложения идут по очереди, а работа бухгалтеров не блокируется.
Процедура Заблокировать() Экспорт
	// Привилегированный режим действует до выхода из этой процедуры (платформа снимает его сама);
	// в безопасном режиме расширения он недоступен, и тогда остаются права пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		// безопасный режим расширения
	КонецПопытки;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.PlatformLog");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

// Документ вида ИмяДокумента, уже созданный из этого источника с этим ExternalID, или Неопределено.
// Удалённый или помеченный на удаление документ не считается: такой импорт создаст документ заново.
Функция НайтиДокумент(Источник, ВнешнийИД, ИмяДокумента) Экспорт
	// Привилегированный режим действует до выхода из этой процедуры (платформа снимает его сама);
	// в безопасном режиме расширения он недоступен, и тогда остаются права пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		// безопасный режим расширения
	КонецПопытки;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Л.DocumentID КАК ИД
	|ИЗ
	|	Справочник.PlatformLog КАК Л
	|ГДЕ
	|	Л.Source = &Источник
	|	И Л.ExternalID = &ВнешнийИД
	|	И Л.DocumentType = &ВидДокумента
	|	И НЕ Л.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Л.CreatedAt УБЫВ");
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ВнешнийИД", ВнешнийИД);
	Запрос.УстановитьПараметр("ВидДокумента", ИмяДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылка = СсылкаНаДокумент(ИмяДокумента, Выборка.ИД);
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура Записать(Источник, ВнешнийИД, Документ, Операция) Экспорт
	// Привилегированный режим действует до выхода из этой процедуры (платформа снимает его сама);
	// в безопасном режиме расширения он недоступен, и тогда остаются права пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		// безопасный режим расширения
	КонецПопытки;
	Запись = Справочники.PlatformLog.СоздатьЭлемент();
	Запись.Наименование = Лев(Операция + " " + ВнешнийИД, 150);
	Запись.Source = Источник;
	Запись.ExternalID = ВнешнийИД;
	Запись.DocumentType = Документ.Метаданные().Имя;
	Запись.DocumentID = Строка(Документ.УникальныйИдентификатор());
	Запись.DocumentPresentation = Лев(Строка(Документ), 150);
	Запись.Operation = Операция;
	Запись.UserName = ИмяПользователя();
	Запись.CreatedAt = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

// Изменение, сделанное ассистентом по подтверждению пользователя: что, с каким объектом и подробности (JSON).
Процедура ЗаписатьИзменение(Операция, Ссылка, Подробности) Экспорт
	// Привилегированный режим действует до выхода из этой процедуры (платформа снимает его сама);
	// в безопасном режиме расширения он недоступен, и тогда остаются права пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		// безопасный режим расширения
	КонецПопытки;
	Запись = Справочники.PlatformLog.СоздатьЭлемент();
	Запись.Наименование = Лев(Операция + " " + Строка(Ссылка), 150);
	Запись.Source = "assistant";
	Запись.ExternalID = Строка(Новый УникальныйИдентификатор);
	Запись.DocumentType = Ссылка.Метаданные().ПолноеИмя();
	Запись.DocumentID = Строка(Ссылка.УникальныйИдентификатор());
	Запись.DocumentPresentation = Лев(Строка(Ссылка), 150);
	Запись.Operation = Операция;
	Запись.Details = Подробности;
	Запись.UserName = ИмяПользователя();
	Запись.CreatedAt = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

#КонецОбласти

#Область Служебные

// Ссылка на существующий и не помеченный на удаление документ, или Неопределено.
Функция СсылкаНаДокумент(ИмяДокумента, ИД)
	Попытка
		Ссылка = Документы[ИмяДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(ИД));
	Исключение
		Возврат Неопределено; // испорченный УИД в журнале
	КонецПопытки;
	Запрос = Новый Запрос(СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.%1 КАК Д
	|ГДЕ
	|	Д.Ссылка = &Ссылка
	|	И НЕ Д.ПометкаУдаления", ИмяДокумента));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат ?(Запрос.Выполнить().Пустой(), Неопределено, Ссылка);
КонецФункции

#КонецОбласти
