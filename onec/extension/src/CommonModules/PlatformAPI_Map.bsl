// Общий модуль PlatformAPI_Map (Сервер ✔, Внешнее соединение ✔).
// Карта имён «Бухгалтерия для Узбекистана», редакция 3.0 (ТЗ §5 «Document mapping»).
// Один модуль на версию конфигурации: обновление 1С = правка этого модуля.
//
// ПРОВЕРИТЬ: имена сверяются с живой базой скриптом
//   pnpm --filter @platform/onec-client metadata -- --file "..." --user "..."
// (результат: onec/mapping/<конфигурация>-<версия>.metadata.json, сводка: onec/mapping/bu-uz-3.0.md).
// Реквизит, которого нет в документе, пропускается при записи; имя справочника или документа
// обязано существовать.

#Область ПрограммныйИнтерфейс

Функция ВерсияРасширения() Экспорт
	Возврат "0.4.0";
КонецФункции

Функция Организации() Экспорт
	Возврат Новый Структура("Справочник, ИНН", "Организации", "ИНН");
КонецФункции

Функция Контрагенты() Экспорт
	Возврат Новый Структура("Справочник, ИНН", "Контрагенты", "ИНН");
КонецФункции

Функция Договоры() Экспорт
	Возврат Новый Структура("Справочник, Владелец", "ДоговорыКонтрагентов", "Владелец");
КонецФункции

Функция Номенклатура() Экспорт
	// ПРОВЕРИТЬ: код ИКПУ может называться «КодИКПУ», «ИКПУ» или храниться в отдельном справочнике.
	Возврат Новый Структура("Справочник, ИКПУ", "Номенклатура", "КодИКПУ");
КонецФункции

Функция СчетФактураПолученный() Экспорт
	Имена = Новый Структура;
	Имена.Вставить("Документ", "СчетФактураПолученный");
	Имена.Вставить("Организация", "Организация");
	Имена.Вставить("Контрагент", "Контрагент");
	Имена.Вставить("Договор", "ДоговорКонтрагента");
	// ПРОВЕРИТЬ: номер и дата счёта-фактуры поставщика.
	Имена.Вставить("НомерВходящего", "НомерВходящегоДокумента");
	Имена.Вставить("ДатаВходящего", "ДатаВходящегоДокумента");
	Имена.Вставить("СуммаВключаетНДС", "СуммаВключаетНДС");
	Имена.Вставить("СуммаДокумента", "СуммаДокумента");
	// ПРОВЕРИТЬ: табличная часть и её колонки.
	Имена.Вставить("Товары", "Товары");
	Имена.Вставить("Номенклатура", "Номенклатура");
	Имена.Вставить("Количество", "Количество");
	Имена.Вставить("Цена", "Цена");
	Имена.Вставить("Сумма", "Сумма");
	Имена.Вставить("СтавкаНДС", "СтавкаНДС");
	Имена.Вставить("СуммаНДС", "СуммаНДС");
	Имена.Вставить("Всего", "Всего");
	Возврат Имена;
КонецФункции

// Счёт-фактура выданный создаётся на основании реализации, как кнопкой «Выписать счет-фактуру».
Функция СчетФактураВыданный() Экспорт
	Имена = Новый Структура;
	Имена.Вставить("Документ", "СчетФактураВыданный");
	Имена.Вставить("Реализация", "РеализацияТоваровУслуг");
	// ПРОВЕРИТЬ: основание счёта-фактуры — реквизит документа или колонка табличной части.
	Имена.Вставить("Основание", "ДокументОснование");
	Имена.Вставить("ТаблицаОснований", "ДокументыОснования");
	Имена.Вставить("Контрагент", "Контрагент");
	Имена.Вставить("Организация", "Организация");
	Имена.Вставить("СуммаДокумента", "СуммаДокумента");
	Возврат Имена;
КонецФункции

#КонецОбласти
