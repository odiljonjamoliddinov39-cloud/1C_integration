# HTTPS with automatic certificates for $DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	# API, MCP endpoint and the agents' WebSocket go to the backend.
	@backend path /api/* /mcp /mcp/* /agent
	reverse_proxy @backend api:8000

	# Everything else is the React app (client-side routing).
	root * /srv
	try_files {path} /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
