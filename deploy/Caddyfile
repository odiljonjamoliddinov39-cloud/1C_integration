# Automatic HTTPS (Let's Encrypt) for SITE_ADDRESS. Without a domain this is <ip-with-dashes>.sslip.io,
# a free name that points to the server's IP, so the desktop app still gets a real certificate.
{$SITE_ADDRESS} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# The Windows installer, linked from the website's Download page.
	handle_path /download/* {
		root * /srv/downloads
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		# The assistant's answer streams as it is written: no compression or buffering on that path.
		@compressible not path /v1/ai/*
		encode @compressible gzip
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
}
