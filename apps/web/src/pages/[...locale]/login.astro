---
import { AuthForm } from "../../components/AuthForm";
import Base from "../../layouts/Base.astro";
import { dict, localeOf, localePaths } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const t = dict(locale).auth;
---

<Base locale={locale} path="/login" title={t.loginTitle}>
  <div class="aurora min-h-[calc(100vh-5rem)]">
    <div class="grid-bg"></div>
    <section class="mx-auto max-w-md px-4 py-16">
      <h1 class="reveal text-4xl font-extrabold tracking-tight"><span class="gradient-text">{t.loginTitle}</span></h1>
      <p class="reveal mt-3 text-muted-foreground" style="--d:60ms">{t.loginSubtitle}</p>
      <div class="reveal glass gradient-border mt-8 rounded-3xl p-7 shadow-2xl shadow-primary/15" style="--d:120ms">
        <AuthForm client:load locale={locale} mode="login" />
      </div>
    </section>
  </div>
</Base>
