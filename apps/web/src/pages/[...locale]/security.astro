---
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import Base from "../../layouts/Base.astro";
import type { IconName } from "../../lib/icons";
import { dict, localeOf, localePaths } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const t = dict(locale).security;
const icons: IconName[] = ["lock", "shield", "monitor", "check"];
---

<Base locale={locale} path="/security" title={t.title}>
  <PageHero title={t.title} subtitle={t.subtitle} narrow />
  <section class="mx-auto max-w-4xl px-4 py-14">
    <div class="reveal overflow-x-auto rounded-3xl border border-border bg-card shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="bg-muted/70">
          <tr><th class="px-5 py-3.5 font-semibold">{t.tableWhat}</th><th class="px-5 py-3.5 font-semibold">{t.tableWhere}</th></tr>
        </thead>
        <tbody class="divide-y divide-border">
          {t.rows.map(([what, where]) => <tr class="transition-colors hover:bg-muted/40"><td class="px-5 py-3.5 font-medium">{what}</td><td class="px-5 py-3.5 text-muted-foreground">{where}</td></tr>)}
        </tbody>
      </table>
    </div>
    <h2 class="reveal mt-16 text-2xl font-extrabold tracking-tight md:text-3xl">{t.principlesTitle}</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        t.principles.map((p, i) => (
          <div class="reveal spot rounded-3xl p-7" style={`--d:${(i % 2) * 90}ms`}>
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-teal/10 text-teal"><Icon name={icons[i % 4] as IconName} class="h-5 w-5" /></span>
            <h3 class="mt-4 text-lg font-bold">{p.title}</h3>
            <p class="mt-1.5 leading-relaxed text-muted-foreground">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
