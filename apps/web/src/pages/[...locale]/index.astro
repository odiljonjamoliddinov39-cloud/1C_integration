---
import Base from "../../layouts/Base.astro";
import { dict, href, localeOf, localePaths } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const t = dict(locale).home;
---

<Base locale={locale} path="/">
  <section class="relative overflow-hidden bg-linear-to-b from-indigo-100/70 to-background dark:from-ink">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-16 pb-16 md:pt-24 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <span class="inline-block rounded-full bg-teal/10 px-3 py-1 text-xs font-semibold text-teal">{t.badge}</span>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight md:text-6xl">{t.title}</h1>
        <p class="mt-5 max-w-xl text-lg text-muted-foreground">{t.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={href(locale, "/signup")} class="rounded-xl bg-primary px-6 py-3 font-semibold text-primary-foreground shadow-lg shadow-primary/30 hover:opacity-90">{t.cta}</a>
          <a href="#how" class="rounded-xl border border-border bg-card px-6 py-3 font-semibold hover:bg-muted">{t.ctaSecondary}</a>
        </div>
      </div>
      <div class="rounded-3xl border border-border bg-card p-4 shadow-2xl shadow-primary/15" aria-hidden="true">
        <div class="flex items-center gap-2 border-b border-border pb-3">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-ink text-[10px] font-bold text-amber-300">AI</span>
          <span class="text-sm font-bold">AI Accounting Assistant</span>
          <span class="ml-auto rounded-full bg-teal/10 px-2 py-0.5 text-xs font-semibold text-teal">1C</span>
        </div>
        <div class="space-y-3 py-4 text-sm">
          <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-md bg-primary px-4 py-2.5 text-primary-foreground">{locale === "uz" ? "Bugun 5110 schyotidagi qoldiq qancha?" : "Какой остаток на счёте 5110 сегодня?"}</div>
          <div class="flex gap-2">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-ink text-[9px] font-bold text-amber-300">AI</span>
            <div class="rounded-2xl rounded-bl-md bg-muted px-4 py-2.5">
              <div class="font-semibold">5110 · {locale === "uz" ? "Hisob-kitob schyoti" : "Расчётный счёт"}</div>
              <div class="tabular-nums text-muted-foreground">125 000 000 {locale === "uz" ? "soʻm" : "сум"}</div>
            </div>
          </div>
          <div class="rounded-2xl border border-primary/30 bg-primary/5 p-3">
            <div class="text-xs font-semibold text-primary">{locale === "uz" ? "1C ga yoziladi — tasdiqlang" : "Запись в 1С — подтвердите"}</div>
            <div class="mt-1.5 flex items-center gap-2 text-xs text-muted-foreground">
              <span class="rounded-lg bg-teal/10 px-2 py-1 font-semibold text-teal">{locale === "uz" ? "2 ta hujjat" : "2 документа"}</span>
              <span class="ml-auto rounded-lg bg-accent px-3 py-1.5 font-semibold text-white">{locale === "uz" ? "Tasdiqlash" : "Подтвердить"}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{t.problemTitle}</h2>
    <ul class="mt-5 grid gap-3 md:grid-cols-3">
      {t.problems.map((p) => <li class="rounded-2xl border border-border bg-card p-6 text-muted-foreground shadow-sm">{p}</li>)}
    </ul>
  </section>

  <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{t.howTitle}</h2>
    <ol class="mt-5 grid gap-4 md:grid-cols-3">
      {
        t.steps.map((s, i) => (
          <li class:list={["rounded-2xl p-6", ["bg-primary/10", "bg-teal/10", "bg-accent/10"][i % 3]]}>
            <span class:list={["flex h-9 w-9 items-center justify-center rounded-xl text-sm font-bold text-white", ["bg-primary", "bg-teal", "bg-accent"][i % 3]]}>{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-10">
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{t.featuresTitle}</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        t.features.map((f, i) => (
          <div class:list={["rounded-2xl border border-border border-t-4 bg-card p-6 shadow-sm", ["border-t-primary", "border-t-teal", "border-t-amber-400", "border-t-accent"][i % 4]]}>
            <div class="flex items-start gap-2">
              <h3 class="font-semibold">{f.title}</h3>
              {f.soon && <span class="ml-auto shrink-0 rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">{t.soon}</span>}
            </div>
            <p class="mt-1 text-sm text-muted-foreground">{f.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="rounded-3xl bg-ink p-10 text-ink-foreground">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{t.securityTitle}</h2>
      <p class="mt-3 max-w-3xl text-ink-muted">{t.securityText}</p>
      <a class="mt-4 inline-block font-semibold text-amber-300 underline" href={href(locale, "/security")}>{t.securityLink}</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-6 pb-20 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight">{t.finalTitle}</h2>
    <p class="mt-2 text-muted-foreground">{t.finalText}</p>
    <a href={href(locale, "/signup")} class="mt-6 inline-block rounded-xl bg-primary shadow-md shadow-primary/25 px-6 py-3 font-medium text-primary-foreground hover:opacity-90">{t.cta}</a>
  </section>
</Base>
