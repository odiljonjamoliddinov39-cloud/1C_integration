---
import Base from "../../layouts/Base.astro";
import { dict, href, localeOf, localePaths } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const t = dict(locale).pricing;
---

<Base locale={locale} path="/pricing" title={t.title}>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-4xl font-bold">{t.title}</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">{t.subtitle}</p>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border-2 border-primary bg-card p-6">
        <h2 class="text-lg font-semibold">{t.trial.name}</h2>
        <div class="mt-3 text-3xl font-bold">{t.trial.price}</div>
        <div class="text-sm text-muted-foreground">{t.trial.period}</div>
        <ul class="mt-5 space-y-2 text-sm">{t.trial.items.map((i) => <li>✓ {i}</li>)}</ul>
        <a href={href(locale, "/signup")} class="mt-6 block rounded-lg bg-primary py-2.5 text-center font-medium text-primary-foreground hover:opacity-90">{t.trial.cta}</a>
      </div>
      {
        t.plans.map((p) => (
          <div class="rounded-2xl border border-border bg-card p-6">
            <h2 class="text-lg font-semibold">{p.name}</h2>
            <div class="mt-3 text-xl font-semibold text-muted-foreground">{t.soon}</div>
            <p class="mt-3 text-sm text-muted-foreground">{p.for}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 max-w-3xl text-sm text-muted-foreground">{t.note}</p>
  </section>
</Base>
