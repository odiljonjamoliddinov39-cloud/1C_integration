---
import { Pricing } from "../../components/Pricing";
import Base from "../../layouts/Base.astro";
import { dict, localeOf, localePaths } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = localeOf(Astro.params.locale);
const t = dict(locale).pricing;
---

<Base locale={locale} path="/pricing" title={t.title}>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-4xl font-bold">{t.title}</h1>
    <p class="mt-3 mb-8 max-w-2xl text-muted-foreground">{t.subtitle}</p>
    <Pricing client:only="react" locale={locale} />
  </section>
</Base>
