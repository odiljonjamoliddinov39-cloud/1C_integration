---
import "../styles/global.css";
import { type Locale, dict, href } from "../lib/i18n";
import { offerOf } from "../lib/offer";

interface Props {
  locale: Locale;
  /** Path without the language prefix, e.g. "/pricing"; used for the language switch. */
  path: string;
  title?: string;
}

const { locale, path, title } = Astro.props;
const t = dict(locale);
const other: Locale = locale === "uz" ? "ru" : "uz";
const offerLink = offerOf(locale).ui.footerLink;
const nav = [
  ["/#features", t.nav.features],
  ["/pricing", t.nav.pricing],
  ["/security", t.nav.security],
  ["/download", t.nav.download],
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap&subset=latin,latin-ext,cyrillic" rel="stylesheet" />
    <meta name="theme-color" content="#4f46e5" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title ? `${title} · AI Accounting Assistant` : t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="alternate" hreflang="uz" href={href("uz", path)} />
    <link rel="alternate" hreflang="ru" href={href("ru", path)} />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <div id="se-loader" class="se-loader fixed inset-0 z-[100] flex flex-col items-center justify-center gap-10 bg-linear-to-br from-[#0b2670] via-[#12399a] to-[#1d5fe0] text-white" aria-hidden="true">
      <div class="flex flex-col items-center gap-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
          <rect x="6" y="12" width="32" height="40" rx="10" fill="#7C3AED" />
          <rect x="26" y="12" width="32" height="40" rx="10" fill="#0D9488" />
          <path d="M36 12h2v40h-2a10 10 0 0 1-10-10V22a10 10 0 0 1 10-10z" fill="#1B1840" />
          <path d="M32 22C32.9 29 34 30.1 41 31C34 31.9 32.9 33 32 40C31.1 33 30 31.9 23 31C30 30.1 31.1 29 32 22Z" fill="#FCD34D" />
        </svg>
        <div class="text-2xl font-bold tracking-tight">AI Accounting Assistant</div>
        <div class="h-1 w-48 overflow-hidden rounded-full bg-white/20"><div class="se-bar h-full w-1/3 rounded-full bg-amber-300"></div></div>
      </div>
      <div class="flex flex-col items-center gap-3">
        <span class="text-[11px] font-semibold tracking-[0.25em] text-white/70 uppercase">{t.footer.madeBy}</span>
        <img src="/space-engineering.webp" alt="" width="176" height="176" class="se-float rounded-[2.2rem] shadow-2xl shadow-black/40" />
      </div>
    </div>
    <noscript><style>#se-loader{display:none}</style></noscript>
    <script is:inline>
      // The first page of a visit shows the start-up screen for 5 seconds; later pages do not.
      (function () {
        var el = document.getElementById("se-loader");
        if (!el) return;
        var seen = false;
        try { seen = sessionStorage.getItem("se-loader") === "1"; } catch (e) {}
        if (seen) { el.remove(); return; }
        var close = function () {
          el.style.opacity = "0";
          setTimeout(function () { el.remove(); }, 500);
          try { sessionStorage.setItem("se-loader", "1"); } catch (e) {}
        };
        var started = Date.now();
        var after = function () { setTimeout(close, Math.max(0, 5000 - (Date.now() - started))); };
        if (document.readyState === "complete") after(); else window.addEventListener("load", after);
        // Never hold the page for long if something is slow to load.
        setTimeout(close, 8000);
      })();
    </script>
    <header class="sticky top-0 z-40 px-2 pt-2 sm:px-3 sm:pt-3">
      <div class="glass mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 rounded-2xl px-3 py-2 shadow-lg shadow-primary/5 sm:px-4 sm:py-2.5">
        <a href={href(locale, "/")} class="flex items-center gap-2.5 text-base font-bold tracking-tight">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">
            <rect x="6" y="12" width="32" height="40" rx="10" fill="#7C3AED" />
            <rect x="26" y="12" width="32" height="40" rx="10" fill="#0D9488" />
            <path d="M36 12h2v40h-2a10 10 0 0 1-10-10V22a10 10 0 0 1 10-10z" fill="#1B1840" />
            <path d="M32 22C32.9 29 34 30.1 41 31C34 31.9 32.9 33 32 40C31.1 33 30 31.9 23 31C30 30.1 31.1 29 32 22Z" fill="#FCD34D" />
          </svg>
          <span class="hidden sm:inline">AI Accounting Assistant</span>
        </a>
        <nav class="order-3 flex w-full gap-1 overflow-x-auto text-sm font-medium text-muted-foreground md:order-none md:w-auto">
          {nav.map(([p, label]) => <a class="rounded-lg px-3 py-1.5 whitespace-nowrap transition-colors hover:bg-muted hover:text-foreground" href={href(locale, p)}>{label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-1.5 text-sm sm:gap-2">
          <a class="rounded-lg border border-border px-2.5 py-1.5 text-xs font-semibold text-muted-foreground uppercase transition-colors hover:text-foreground" href={href(other, path)} hreflang={other}>{other}</a>
          <a class="rounded-lg px-2 py-1.5 text-xs font-medium transition-colors hover:bg-muted sm:px-3 sm:text-sm" href={href(locale, "/login")}>{t.nav.login}</a>
          <a class="btn btn-primary !rounded-xl !px-3 !py-2 text-xs sm:!px-4 sm:text-sm" href={href(locale, "/signup")}>{t.nav.signup}</a>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="relative mt-10 overflow-hidden bg-ink text-ink-foreground">
      <div class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-primary/25 blur-3xl"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-10 sm:py-12">
        <div class="flex flex-wrap items-start gap-x-12 gap-y-8">
          <div class="max-w-xs">
            <span class="flex items-center gap-2.5 font-bold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
                <rect x="6" y="12" width="32" height="40" rx="10" fill="#7C3AED" />
                <rect x="26" y="12" width="32" height="40" rx="10" fill="#0D9488" />
                <path d="M36 12h2v40h-2a10 10 0 0 1-10-10V22a10 10 0 0 1 10-10z" fill="#1B1840" />
                <path d="M32 22C32.9 29 34 30.1 41 31C34 31.9 32.9 33 32 40C31.1 33 30 31.9 23 31C30 30.1 31.1 29 32 22Z" fill="#FCD34D" />
              </svg>
              AI Accounting Assistant
            </span>
            <p class="mt-3 text-sm text-ink-muted">{t.footer.tagline}</p>
          </div>
          <nav class="ml-auto flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-muted">
            {nav.map(([p, label]) => <a class="transition-colors hover:text-ink-foreground" href={href(locale, p)}>{label}</a>)}
            <a class="transition-colors hover:text-ink-foreground" href={href(locale, "/oferta")}>{offerLink}</a>
          </nav>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-6 text-xs text-ink-muted">
          <span>© 2026</span>
          <span class="flex items-center gap-2">
            {t.footer.madeBy}
            <img src="/space-engineering.webp" alt="" width="24" height="24" class="rounded-md" />
            <span class="font-semibold text-ink-foreground">Space Engineering</span>
          </span>
          <span class="ml-auto rounded-full bg-amber-300/15 px-3 py-1 text-amber-200">{t.footer.prototype}</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      // Scroll reveal and the spotlight that follows the pointer over cards.
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) { els.forEach(function (e) { e.classList.add("in"); }); }
        else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
          }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
          els.forEach(function (e) { io.observe(e); });
          // Never leave content hidden if the observer is slow.
          setTimeout(function () { els.forEach(function (e) { e.classList.add("in"); }); }, 4000);
        }
        document.addEventListener("pointermove", function (ev) {
          var card = ev.target && ev.target.closest && ev.target.closest(".spot");
          if (!card) return;
          var r = card.getBoundingClientRect();
          card.style.setProperty("--mx", ev.clientX - r.left + "px");
          card.style.setProperty("--my", ev.clientY - r.top + "px");
        });
      })();
    </script>
  </body>
</html>
