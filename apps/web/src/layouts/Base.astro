---
import "../styles/global.css";
import { type Locale, dict, href } from "../lib/i18n";

interface Props {
  locale: Locale;
  /** Path without the language prefix, e.g. "/pricing"; used for the language switch. */
  path: string;
  title?: string;
}

const { locale, path, title } = Astro.props;
const t = dict(locale);
const other: Locale = locale === "uz" ? "ru" : "uz";
const nav = [
  ["/#features", t.nav.features],
  ["/pricing", t.nav.pricing],
  ["/security", t.nav.security],
  ["/faq", t.nav.faq],
  ["/download", t.nav.download],
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · 1C Platform` : t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="alternate" hreflang="uz" href={href("uz", path)} />
    <link rel="alternate" hreflang="ru" href={href("ru", path)} />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <header class="sticky top-0 z-10 border-b border-border bg-background/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href={href(locale, "/")} class="flex items-center gap-2 font-semibold">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-primary-foreground">1C</span>
          1C Platform
        </a>
        <nav class="order-3 flex w-full gap-4 overflow-x-auto text-sm text-muted-foreground md:order-none md:w-auto">
          {nav.map(([p, label]) => <a class="whitespace-nowrap hover:text-foreground" href={href(locale, p)}>{label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-3 text-sm">
          <a class="rounded-md px-2 py-1 text-muted-foreground uppercase hover:text-foreground" href={href(other, path)} hreflang={other}>{other}</a>
          <a class="hover:text-primary" href={href(locale, "/login")}>{t.nav.login}</a>
          <a class="rounded-lg bg-primary px-3 py-2 font-medium text-primary-foreground hover:opacity-90" href={href(locale, "/signup")}>{t.nav.signup}</a>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-4 px-4 py-6 text-sm text-muted-foreground">
        <span>© 2026 1C Platform · {t.footer.tagline}</span>
        <span class="ml-auto rounded-full bg-warning/20 px-2 py-0.5 text-xs text-foreground">{t.footer.prototype}</span>
      </div>
    </footer>
  </body>
</html>
