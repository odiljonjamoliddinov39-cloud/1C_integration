// HTTP-сервис aiapi (корневой URL "aiapi"). Публикуется только на 127.0.0.1.
// Каждый обработчик передаёт запрос в AIAPI_Общий.Обработать: там проверка токена,
// маршрутизация, сериализация в JSON и единый формат ошибок
// {"error": "code", "message": "text", "details": {}}.
//
// Шаблоны URL (имя шаблона -> шаблон -> метод -> обработчик):
//   Пинг           /v1/ping                 GET   ПингGET
//   Справочник     /v1/catalogs/{name}      GET   СправочникGET
//   Документы      /v1/documents/{type}     GET   ДокументыGET
//   Проводки       /v1/ledger               GET   ПроводкиGET
//   Остатки        /v1/balances             GET   ОстаткиGET
//   Изменения      /v1/changes              GET   ИзмененияGET
//   СчетаФактуры   /v1/invoices             POST  СчетаФактурыPOST
//   ПровестиСФ     /v1/invoices/{id}/post   POST  ПровестиСчетФактуруPOST
//   Исправления    /v1/fixes                POST  ИсправленияPOST
//   Исправление    /v1/fixes/{id}           GET   ИсправлениеGET

Функция ПингGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "ping");
КонецФункции

Функция СправочникGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "catalog");
КонецФункции

Функция ДокументыGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "documents");
КонецФункции

Функция ПроводкиGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "ledger");
КонецФункции

Функция ОстаткиGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "balances");
КонецФункции

Функция ИзмененияGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "changes");
КонецФункции

Функция СчетаФактурыPOST(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "create_invoice");
КонецФункции

Функция ПровестиСчетФактуруPOST(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "post_invoice");
КонецФункции

Функция ИсправленияPOST(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "apply_fix");
КонецФункции

Функция ИсправлениеGET(Запрос)
	Возврат AIAPI_Общий.Обработать(Запрос, "get_fix");
КонецФункции
