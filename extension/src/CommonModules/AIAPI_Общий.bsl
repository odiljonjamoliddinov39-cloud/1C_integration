// Общий модуль AIAPI_Общий (Сервер, вызов сервера: нет, привилегированный: да).
// Проверка токена, маршрутизация, JSON, ошибки.

#Область ПрограммныйИнтерфейс

// Точка входа всех обработчиков HTTP-сервиса.
Функция Обработать(Запрос, Операция) Экспорт

	Если Не ТокенВерный(Запрос) Тогда
		Возврат ОтветОшибка(401, "unauthorized", "Неверный или отсутствующий токен");
	КонецЕсли;

	Попытка
		Параметры = ПараметрыЗапроса(Запрос);
		Если Операция = "ping" Тогда
			Данные = AIAPI_Чтение.Пинг();
		ИначеЕсли Операция = "catalog" Тогда
			Данные = AIAPI_Чтение.Справочник(Запрос.ПараметрыURL["name"], Параметры);
		ИначеЕсли Операция = "documents" Тогда
			Данные = AIAPI_Чтение.Документы(Запрос.ПараметрыURL["type"], Параметры);
		ИначеЕсли Операция = "ledger" Тогда
			Данные = AIAPI_Чтение.Проводки(Параметры);
		ИначеЕсли Операция = "balances" Тогда
			Данные = AIAPI_Чтение.Остатки(Параметры);
		ИначеЕсли Операция = "changes" Тогда
			Данные = AIAPI_Чтение.Изменения(Параметры);
		ИначеЕсли Операция = "create_invoice" Тогда
			Данные = AIAPI_Запись.СоздатьСчетФактуру(ТелоJSON(Запрос));
		ИначеЕсли Операция = "post_invoice" Тогда
			Тело = ТелоJSON(Запрос);
			Тело.Вставить("ref", Запрос.ПараметрыURL["id"]);
			Данные = AIAPI_Запись.ПровестиСчетФактуру(Тело);
		ИначеЕсли Операция = "apply_fix" Тогда
			Данные = AIAPI_Запись.ПрименитьИсправление(ТелоJSON(Запрос));
		ИначеЕсли Операция = "get_fix" Тогда
			Данные = AIAPI_Запись.РезультатОдобрения(Запрос.ПараметрыURL["id"]);
			Если Данные = Неопределено Тогда
				ВызватьОшибкуAPI(404, "not_found", "Исправление не найдено");
			КонецЕсли;
		ИначеЕсли Операция = "metadata" Тогда
			Данные = AIAPI_Объекты.СоставКонфигурации();
		ИначеЕсли Операция = "objects_list" Тогда
			Данные = AIAPI_Объекты.СписокОбъектов(ПараметрURL(Запрос, "kind"), ПараметрURL(Запрос, "name"), Параметры);
		ИначеЕсли Операция = "object_get" Тогда
			Данные = AIAPI_Объекты.ОбъектПоСсылке(ПараметрURL(Запрос, "kind"), ПараметрURL(Запрос, "name"), ПараметрURL(Запрос, "id"));
		ИначеЕсли Операция = "query" Тогда
			Данные = AIAPI_Объекты.ВыполнитьЗапрос(ТелоJSON(Запрос));
		ИначеЕсли Операция = "object_create" Тогда
			Данные = AIAPI_Объекты.ИзменитьОбъект(ПараметрURL(Запрос, "kind"), ПараметрURL(Запрос, "name"),
				"create", Неопределено, ТелоJSON(Запрос));
		ИначеЕсли Операция = "object_update" Тогда
			Тело = ТелоJSON(Запрос);
			Действие = Тело.Получить("action");
			Если Действие <> "update" И Действие <> "restore" Тогда
				ВызватьОшибкуAPI(400, "bad_action", "PUT принимает action = update или restore");
			КонецЕсли;
			Данные = AIAPI_Объекты.ИзменитьОбъект(ПараметрURL(Запрос, "kind"), ПараметрURL(Запрос, "name"),
				Действие, ПараметрURL(Запрос, "id"), Тело);
		ИначеЕсли Операция = "object_action" Тогда
			Действие = ПараметрURL(Запрос, "action");
			Если Действие = "create" Или Действие = "update" Или Действие = "restore" Тогда
				ВызватьОшибкуAPI(400, "bad_action", "Это действие выполняется через POST/PUT объекта");
			КонецЕсли;
			Данные = AIAPI_Объекты.ИзменитьОбъект(ПараметрURL(Запрос, "kind"), ПараметрURL(Запрос, "name"),
				Действие, ПараметрURL(Запрос, "id"), ТелоJSON(Запрос));
		Иначе
			ВызватьОшибкуAPI(404, "not_found", "Неизвестная операция");
		КонецЕсли;
		Возврат ОтветJSON(200, Данные);

	Исключение
		Информация = ИнформацияОбОшибке();
		Текст = КраткоеПредставлениеОшибки(Информация);
		Ошибка = РазобратьОшибкуAPI(Текст);
		Если Ошибка <> Неопределено Тогда
			Возврат ОтветОшибка(Ошибка.Код, Ошибка.Ошибка, Ошибка.Сообщение);
		КонецЕсли;
		ЗаписьЖурналаРегистрации("AIAPI", УровеньЖурналаРегистрации.Ошибка, , Операция,
			ПодробноеПредставлениеОшибки(Информация));
		Если СтрНайти(НРег(Текст), "запрет") > 0 И СтрНайти(НРег(Текст), "дат") > 0 Тогда
			Возврат ОтветОшибка(409, "closed_period", Текст);
		КонецЕсли;
		Возврат ОтветОшибка(500, "internal_error", Текст);
	КонецПопытки;

КонецФункции

// Прерывает обработку с HTTP-кодом и кодом ошибки API.
Процедура ВызватьОшибкуAPI(Код, Ошибка, Сообщение) Экспорт
	ВызватьИсключение СтрШаблон("[AIAPI:%1:%2] %3", Формат(Код, "ЧГ="), Ошибка, Сообщение);
КонецПроцедуры

Функция ДатаВСтроку(Дата) Экспорт
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция СтрокаВДату(Значение, НачалоДняЕслиПусто = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат НачалоДняЕслиПусто;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Значение, 19), "-", ""), ":", ""), "T", "");
	Если СтрДлина(Текст) = 8 Тогда
		Текст = Текст + "000000";
	КонецЕсли;
	Возврат Дата(Текст);
КонецФункции

// UUID ссылки или Неопределено для пустой ссылки.
Функция УИД(Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

// Массив строк из параметра refs=a,b,c (или Неопределено).
Функция СписокСсылок(Параметры) Экспорт
	Значение = Параметры.Получить("refs");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрРазделить(Значение, ",", Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТокенВерный(Запрос)
	Ожидаемый = Константы.ТокенAIAPI.Получить();
	Если Не ЗначениеЗаполнено(Ожидаемый) Тогда
		Возврат Ложь; // пока токен не задан, сервис закрыт
	КонецЕсли;
	Заголовок = Запрос.Заголовки.Получить("Authorization");
	Если Заголовок = Неопределено Тогда
		Заголовок = Запрос.Заголовки.Получить("authorization");
	КонецЕсли;
	Возврат Заголовок = "Bearer " + Ожидаемый;
КонецФункции

// Параметр шаблона URL; имена объектов приходят кириллицей и могут быть в %-кодировке.
Функция ПараметрURL(Запрос, Имя)
	Значение = Запрос.ПараметрыURL.Получить(Имя);
	Если Значение <> Неопределено И СтрНайти(Значение, "%") > 0 Тогда
		Значение = РаскодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПараметрыЗапроса(Запрос)
	Результат = Новый Соответствие;
	Для Каждого КлючЗначение Из Запрос.ПараметрыЗапроса Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТелоJSON(Запрос)
	Текст = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьОшибкуAPI(400, "bad_request", "Пустое тело запроса");
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ОтветJSON(Код, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибка(Код, Ошибка, Сообщение)
	Тело = Новый Структура("error, message, details", Ошибка, Сообщение, Новый Структура);
	Возврат ОтветJSON(Код, Тело);
КонецФункции

// Разбирает текст "[AIAPI:409:closed_period] Сообщение".
Функция РазобратьОшибкуAPI(Текст)
	Начало = СтрНайти(Текст, "[AIAPI:");
	Если Начало = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Конец = СтрНайти(Текст, "]", , Начало);
	Части = СтрРазделить(Сред(Текст, Начало + 7, Конец - Начало - 7), ":");
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Код", Число(Части[0]));
	Результат.Вставить("Ошибка", Части[1]);
	Результат.Вставить("Сообщение", СокрЛП(Сред(Текст, Конец + 1)));
	Возврат Результат;
КонецФункции

#КонецОбласти
