// Общий модуль AIAPI_Метаданные (Сервер, привилегированный).
// Все имена объектов и реквизитов конфигурации собраны здесь.
// ПРОВЕРИТЬ на копии базы TEST_CRYSTAL: имена в «Бухгалтерии для Узбекистана 3.0» могут
// отличаться между релизами. Меняется только этот модуль, остальной код от имён не зависит.

#Область ПрограммныйИнтерфейс

// Тип документа API -> имя документа в конфигурации.
Функция ТипыДокументов() Экспорт
	Типы = Новый Соответствие;
	Типы.Вставить("sale", "РеализацияТоваровУслуг");
	Типы.Вставить("purchase", "ПоступлениеТоваровУслуг");
	Типы.Вставить("invoice_out", "СчетФактураВыданный");
	Типы.Вставить("invoice_in", "СчетФактураПолученный");
	Типы.Вставить("cash_in", "ПриходныйКассовыйОрдер");
	Типы.Вставить("cash_out", "РасходныйКассовыйОрдер");
	Типы.Вставить("bank_in", "ПоступлениеНаРасчетныйСчет");
	Типы.Вставить("bank_out", "СписаниеСРасчетногоСчета");
	Типы.Вставить("operation", "ОперацияБух"); // ПРОВЕРИТЬ: «Операция» / «ОперацияБух»
	Возврат Типы;
КонецФункции

// Имя документа конфигурации -> тип API (или Неопределено).
Функция ТипДокументаAPI(ИмяМетаданных) Экспорт
	Для Каждого КлючЗначение Из ТипыДокументов() Цикл
		Если КлючЗначение.Значение = ИмяМетаданных Тогда
			Возврат КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Имя справочника API -> имя справочника в конфигурации.
Функция Справочники() Экспорт
	Имена = Новый Соответствие;
	Имена.Вставить("counterparties", "Контрагенты");
	Имена.Вставить("contracts", "ДоговорыКонтрагентов");
	Имена.Вставить("items", "Номенклатура");
	Имена.Вставить("warehouses", "Склады");
	Имена.Вставить("organizations", "Организации");
	Возврат Имена;
КонецФункции

Функция ИмяСправочникаAPI(ИмяМетаданных) Экспорт
	Для Каждого КлючЗначение Из Справочники() Цикл
		Если КлючЗначение.Значение = ИмяМетаданных Тогда
			Возврат КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Имена реквизитов. ПРОВЕРИТЬ по конфигурации.
Функция Реквизиты() Экспорт
	Р = Новый Структура;
	Р.Вставить("ИНН", "ИНН");                          // Контрагенты, Организации
	Р.Вставить("ВладелецДоговора", "Владелец");        // ДоговорыКонтрагентов
	Р.Вставить("НомерДоговора", "Номер");
	Р.Вставить("ДатаДоговора", "Дата");
	Р.Вставить("ЕдиницаИзмерения", "ЕдиницаИзмерения"); // Номенклатура
	Р.Вставить("СтавкаНДС", "СтавкаНДС");
	Р.Вставить("ИКПУ", "КодИКПУ");                     // ПРОВЕРИТЬ: «ИКПУ» / «КодТНВЭД» / отдельный справочник
	Р.Вставить("Цена", "Цена");                        // если цены в регистре — см. ЦенаНоменклатуры()
	Р.Вставить("Контрагент", "Контрагент");            // шапка документов
	Р.Вставить("Договор", "ДоговорКонтрагента");
	Р.Вставить("Склад", "Склад");
	Р.Вставить("Организация", "Организация");
	Р.Вставить("СуммаДокумента", "СуммаДокумента");
	Р.Вставить("ТабличнаяЧасть", "Товары");
	Р.Вставить("Количество", "Количество");
	Р.Вставить("ЦенаСтроки", "Цена");
	Р.Вставить("СуммаСтроки", "Сумма");
	Р.Вставить("СтавкаНДССтроки", "СтавкаНДС");
	Р.Вставить("СуммаНДССтроки", "СуммаНДС");
	Р.Вставить("СуммаВключаетНДС", "СуммаВключаетНДС");
	Возврат Р;
КонецФункции

Функция ЕстьРеквизит(МетаданныеОбъекта, Имя) Экспорт
	Возврат МетаданныеОбъекта.Реквизиты.Найти(Имя) <> Неопределено;
КонецФункции

// Ставка НДС любого вида (число, перечисление, справочник) -> число процентов или Неопределено.
Функция СтавкаЧислом(Ставка) Экспорт
	Если Ставка = Неопределено Или Ставка = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Ставка) = Тип("Число") Тогда
		Возврат Ставка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеСтавки = Ставка.Метаданные();
	Если Метаданные.Справочники.Содержит(МетаданныеСтавки) Тогда
		Если МетаданныеСтавки.Реквизиты.Найти("Ставка") <> Неопределено Тогда
			Возврат Ставка.Ставка;
		КонецЕсли;
	КонецЕсли;
	// Перечисление: НДС12, НДС15, НДС0, БезНДС
	Имя = XMLСтрока(Ставка);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Цифры = "", 0, Число(Цифры));
КонецФункции

// Число процентов -> значение ставки того типа, который хранит реквизит.
Функция СтавкаИзЧисла(Процент, ПримерЗначения) Экспорт
	Если ТипЗнч(ПримерЗначения) = Тип("Число") Тогда
		Возврат Процент;
	КонецЕсли;
	МетаданныеСтавки = ПримерЗначения.Метаданные();
	Если Метаданные.Перечисления.Содержит(МетаданныеСтавки) Тогда
		Менеджер = Перечисления[МетаданныеСтавки.Имя];
		Для Каждого Значение Из МетаданныеСтавки.ЗначенияПеречисления Цикл
			Кандидат = Менеджер[Значение.Имя];
			Если СтавкаЧислом(Кандидат) = Процент Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеСтавки) Тогда
		Ссылка = Справочники[МетаданныеСтавки.Имя].НайтиПоРеквизиту("Ставка", Процент);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_vat_rate", "Не найдена ставка НДС " + Процент);
КонецФункции

// Пустая ставка нужного типа (для подбора значения перечисления/справочника).
Функция ПримерСтавки(ИмяДокумента) Экспорт
	ТЧ = Метаданные.Документы[ИмяДокумента].ТабличныеЧасти[Реквизиты().ТабличнаяЧасть];
	Тип = ТЧ.Реквизиты[Реквизиты().СтавкаНДССтроки].Тип.Типы()[0];
	Возврат Новый(Тип);
КонецФункции

// Ссылка документа любого типа API по UUID.
Функция СсылкаДокумента(ТипAPI, УИД) Экспорт
	Имя = ТипыДокументов().Получить(ТипAPI);
	Если Имя = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_type", "Неизвестный тип документа " + ТипAPI);
	КонецЕсли;
	Возврат Документы[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
КонецФункции

Функция СсылкаСправочника(ИмяAPI, УИД) Экспорт
	Если Не ЗначениеЗаполнено(УИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники[Справочники().Получить(ИмяAPI)].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
КонецФункции

// Дата запрета изменения для всех пользователей (БСП) или Неопределено.
Функция ОбщаяДатаЗапрета() Экспорт
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Д.ДатаЗапрета КАК ДатаЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК Д
		|ГДЕ
		|	Д.Пользователь = ЗНАЧЕНИЕ(Перечисление.ВидыНазначенияДатЗапрета.ДляВсехПользователей)
		|УПОРЯДОЧИТЬ ПО
		|	Д.ДатаЗапрета УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ДатаЗапрета) Тогда
			Возврат Выборка.ДатаЗапрета;
		КонецЕсли;
	Исключение
		// В базе нет подсистемы дат запрета БСП или другая структура регистра.
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Вызывает ошибку 409, если объект попадает в закрытый период.
Процедура ПроверитьДатуЗапрета(Объект) Экспорт
	Запрещено = Ложь;
	Попытка
		Запрещено = ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект);
	Исключение
		// Нет БСП-функции: сравниваем дату документа с общей датой запрета.
		ДатаЗапрета = ОбщаяДатаЗапрета();
		ЭтоДокумент = Метаданные.Документы.Содержит(Объект.Метаданные());
		Запрещено = ЭтоДокумент И ДатаЗапрета <> Неопределено И НачалоДня(Объект.Дата) <= ДатаЗапрета;
	КонецПопытки;
	Если Запрещено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(409, "closed_period", "Период закрыт (дата запрета изменения)");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
