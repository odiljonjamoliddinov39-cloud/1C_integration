// Общий модуль AIAPI_Объекты (Сервер, привилегированный).
// Прямой доступ к любой части базы, а не только к зеркалируемым справочникам и документам:
//
//   GET  /metadata                             состав конфигурации
//   GET  /objects/{kind}/{name}                список: refs, from, to, filter (JSON), limit, offset, include_deleted
//   GET  /objects/{kind}/{name}/{id}           один объект целиком (реквизиты и табличные части)
//   POST /query                                запрос на языке запросов 1С: {text, params, limit}
//   POST /objects/{kind}/{name}                создать справочник или документ
//   PUT  /objects/{kind}/{name}/{id}           action = update (data) или restore (snapshot)
//   POST /objects/{kind}/{name}/{id}/{action}  post, unpost, mark_deletion, unmark_deletion
//
// kind: catalog, document, information_register, accumulation_register, accounting_register,
//       chart_of_accounts, chart_of_characteristic_types, enum. Менять можно только catalog и document.
//
// Запись — только с approval_id, по правилам AIAPI_Запись: повтор возвращает сохранённый
// результат, одна транзакция, запись в ЖурналИзмененийAI, 409 для закрытого периода.
//
// Значения в JSON:
//   строка, число, булево — как есть; дата — "2026-09-30T12:00:00"; пустая ссылка — null;
//   ссылка — {"_type": "Справочник.Контрагенты", "ref": "<uuid>", "presentation": "..."};
//   счёт — то же плюс "code" (при записи можно передать только "code");
//   перечисление — {"_type": "Перечисление.СтавкиНДС", "value": "НДС12", "presentation": "..."}.
// Реквизиты типа ХранилищеЗначения не читаются и не меняются.

#Область ПрограммныйИнтерфейс

Функция СоставКонфигурации() Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("synonym", Метаданные.Синоним);
	Результат.Вставить("version", Метаданные.Версия);
	Результат.Вставить("base_name", AIAPI_Чтение.Пинг().base_name);
	Результат.Вставить("catalogs", ОписанияМетаданных(Метаданные.Справочники, "catalog"));
	Результат.Вставить("documents", ОписанияМетаданных(Метаданные.Документы, "document"));
	Результат.Вставить("information_registers", ОписанияМетаданных(Метаданные.РегистрыСведений, "information_register"));
	Результат.Вставить("accumulation_registers", ОписанияМетаданных(Метаданные.РегистрыНакопления, "accumulation_register"));
	Результат.Вставить("accounting_registers", ОписанияМетаданных(Метаданные.РегистрыБухгалтерии, "accounting_register"));
	Результат.Вставить("charts_of_accounts", ОписанияМетаданных(Метаданные.ПланыСчетов, "chart_of_accounts"));
	Результат.Вставить("charts_of_characteristic_types",
		ОписанияМетаданных(Метаданные.ПланыВидовХарактеристик, "chart_of_characteristic_types"));
	Результат.Вставить("enums", ОписанияМетаданных(Метаданные.Перечисления, "enum"));
	Возврат Результат;
КонецФункции

Функция СписокОбъектов(Вид, Имя, Параметры) Экспорт
	МД = ОбъектМетаданных(Вид, Имя);
	Лимит = Мин(ЧислоПараметра(Параметры, "limit", 100), МаксимумСтрок());
	Смещение = ЧислоПараметра(Параметры, "offset", 0);

	Результат = Новый Соответствие;
	Результат.Вставить("kind", Вид);
	Результат.Вставить("name", Имя);
	Элементы = Новый Массив;

	Если Вид = "enum" Тогда
		Менеджер = Перечисления[МД.Имя];
		Для Каждого Значение Из МД.ЗначенияПеречисления Цикл
			Элементы.Добавить(ЗначениеВJSON(Менеджер[Значение.Имя]));
		КонецЦикла;
		Результат.Вставить("total", Элементы.Количество());
		Результат.Вставить("items", Элементы);
		Возврат Результат;
	КонецЕсли;

	Ссылочный = ЭтоСсылочныйВид(Вид);
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Если Ссылочный Тогда
		Если Параметры.Получить("include_deleted") <> "true" Тогда
			Условия.Добавить("НЕ Т.ПометкаУдаления");
		КонецЕсли;
		УИДы = AIAPI_Общий.СписокСсылок(Параметры);
		Если УИДы <> Неопределено Тогда
			Менеджер = МенеджерПоМетаданным(МД);
			Ссылки = Новый Массив;
			Для Каждого УИД Из УИДы Цикл
				Ссылки.Добавить(Менеджер.ПолучитьСсылку(УИДИзСтроки(УИД, "refs")));
			КонецЦикла;
			Условия.Добавить("Т.Ссылка В (&Ссылки)");
			Запрос.УстановитьПараметр("Ссылки", Ссылки);
		КонецЕсли;
	КонецЕсли;

	ПолеДаты = ПолеПериода(МД, Вид);
	Если ЗначениеЗаполнено(ПолеДаты) И ЗначениеЗаполнено(Параметры.Получить("from")) Тогда
		Условия.Добавить("Т." + ПолеДаты + " >= &Начало");
		Запрос.УстановитьПараметр("Начало", AIAPI_Общий.СтрокаВДату(Параметры.Получить("from")));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПолеДаты) И ЗначениеЗаполнено(Параметры.Получить("to")) Тогда
		Условия.Добавить("Т." + ПолеДаты + " <= &Конец");
		Запрос.УстановитьПараметр("Конец", КонецДня(AIAPI_Общий.СтрокаВДату(Параметры.Получить("to"))));
	КонецЕсли;

	Отбор = ОтборИзПараметра(Параметры.Получить("filter"));
	Номер = 0;
	Для Каждого КлючИЗначение Из Отбор Цикл
		Номер = Номер + 1;
		Типы = ТипПоляОтбора(МД, Вид, КлючИЗначение.Ключ);
		ИмяПараметра = "Отбор" + Формат(Номер, "ЧГ=");
		Поле = "Т." + КлючИЗначение.Ключ;
		Если Типы.СодержитТип(Тип("Строка")) И Типы.КвалификаторыСтроки.Длина = 0 Тогда
			Поле = "ВЫРАЗИТЬ(" + Поле + " КАК СТРОКА(1024))"; // строки неограниченной длины нельзя сравнивать
		КонецЕсли;
		Условия.Добавить(Поле + " = &" + ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеИзJSON(КлючИЗначение.Значение, Типы, КлючИЗначение.Ключ));
	КонецЦикла;

	Источник = " ИЗ " + МД.ПолноеИмя() + " КАК Т";
	Где = ?(Условия.Количество() = 0, "", " ГДЕ " + СтрСоединить(Условия, " И "));
	Порядок = "";
	Если ЗначениеЗаполнено(ПолеДаты) Тогда
		Порядок = " УПОРЯДОЧИТЬ ПО Т." + ПолеДаты + ?(Ссылочный, ", Т.Ссылка", "");
	ИначеЕсли Ссылочный Тогда
		Порядок = " УПОРЯДОЧИТЬ ПО Т.Ссылка";
	КонецЕсли;

	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего" + Источник + Где;
	Выборка = Запрос.Выполнить().Выбрать();
	Результат.Вставить("total", ?(Выборка.Следующий(), Выборка.Всего, 0));

	Первые = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Смещение + Лимит, "ЧГ=");
	Запрос.Текст = Первые + ?(Ссылочный, " Т.Ссылка КАК Ссылка", " *") + Источник + Где + Порядок;
	РезультатЗапроса = Запрос.Выполнить();
	Колонки = РезультатЗапроса.Колонки;
	Выборка = РезультатЗапроса.Выбрать();
	Пропущено = 0;
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Смещение Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Ссылочный Тогда
			Элементы.Добавить(ОписаниеОбъекта(Выборка.Ссылка.ПолучитьОбъект(), МД, Вид));
		Иначе
			Запись = Новый Соответствие;
			Для Каждого Колонка Из Колонки Цикл
				Запись.Вставить(Колонка.Имя, ЗначениеВJSON(Выборка[Колонка.Имя]));
			КонецЦикла;
			Элементы.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("items", Элементы);
	Возврат Результат;
КонецФункции

Функция ОбъектПоСсылке(Вид, Имя, УИД) Экспорт
	МД = ОбъектМетаданных(Вид, Имя);
	Возврат ОписаниеОбъекта(СуществующийОбъект(МД, УИД), МД, Вид);
КонецФункции

// Запрос на языке запросов 1С. Язык запросов не меняет данные, поэтому запрос только читает.
// Тело: {text, params: {Имя: значение}, limit}. Ответ: {columns, rows, truncated}.
Функция ВыполнитьЗапрос(Тело) Экспорт
	Текст = Тело.Получить("text");
	Если Не ЗначениеЗаполнено(Текст) Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_query", "Нужен текст запроса (text)");
	КонецЕсли;
	Лимит = Тело.Получить("limit");
	Лимит = Мин(?(ЗначениеЗаполнено(Лимит), Число(Лимит), 1000), МаксимумСтрокЗапроса());

	Запрос = Новый Запрос(Текст);
	Параметры = Тело.Получить("params");
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, ПараметрЗапроса(КлючИЗначение.Значение, КлючИЗначение.Ключ));
		КонецЦикла;
	КонецЕсли;
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_query", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Обрезано = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= Лимит Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		СтрокаJSON = Новый Массив;
		Для Индекс = 0 По Колонки.ВГраница() Цикл
			СтрокаJSON.Добавить(ЗначениеВJSON(Выборка.Получить(Индекс)));
		КонецЦикла;
		Строки.Добавить(СтрокаJSON);
	КонецЦикла;

	Результат = Новый Соответствие;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("truncated", Обрезано);
	Возврат Результат;
КонецФункции

// Одобренное изменение справочника или документа.
// Тело: {approval_id, approved_by, fix_id, data, post, snapshot}. Ответ: {fix_id, ref, before, after}.
Функция ИзменитьОбъект(Вид, Имя, Действие, УИД, Тело) Экспорт
	ИД = AIAPI_Запись.ИдентификаторОдобрения(Тело);
	Предыдущий = AIAPI_Запись.РезультатОдобрения(ИД);
	Если Предыдущий <> Неопределено Тогда
		Возврат Предыдущий;
	КонецЕсли;
	Если Вид <> "catalog" И Вид <> "document" Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "not_writable", "Менять можно только справочники и документы");
	КонецЕсли;
	Если СтрРазделить("create,update,restore,post,unpost,mark_deletion,unmark_deletion", ",").Найти(Действие) = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_action", "Неизвестное действие " + Действие);
	КонецЕсли;
	МД = ОбъектМетаданных(Вид, Имя);
	Если (Действие = "post" Или Действие = "unpost" Или Тело.Получить("post") = Истина)
		И (Вид <> "document" Или МД.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить) Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_action", Имя + " не проводится");
	КонецЕсли;
	Данные = Тело.Получить("data");
	Провести = Тело.Получить("post") = Истина;

	НачатьТранзакцию();
	Попытка
		До = Неопределено;
		Если Действие = "create" Тогда
			Объект = НовыйОбъект(МД, Вид, Данные);
			ПрименитьДанные(Объект, МД, Вид, Данные);
			Если Вид = "document" И Не ЗначениеЗаполнено(Объект.Дата) Тогда
				Объект.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
			AIAPI_Метаданные.ПроверитьДатуЗапрета(Объект);
			ЗаписатьВРежиме(Объект, Вид, Провести);
		Иначе
			Объект = СуществующийОбъект(МД, УИД);
			AIAPI_Метаданные.ПроверитьДатуЗапрета(Объект);
			До = ОписаниеОбъекта(Объект, МД, Вид);
			Если Действие = "update" Тогда
				ПрименитьДанные(Объект, МД, Вид, Данные);
				AIAPI_Метаданные.ПроверитьДатуЗапрета(Объект); // новая дата тоже не должна быть в закрытом периоде
				ЗаписатьВРежиме(Объект, Вид, Провести Или (Вид = "document" И Объект.Проведен));
			ИначеЕсли Действие = "restore" Тогда
				ВосстановитьСнимок(Объект, МД, Вид, Тело.Получить("snapshot"));
			ИначеЕсли Действие = "post" Тогда
				Объект.Записать(РежимЗаписиДокумента.Проведение);
			ИначеЕсли Действие = "unpost" Тогда
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ИначеЕсли Действие = "mark_deletion" Тогда
				Объект.УстановитьПометкуУдаления(Истина); // проведённый документ при этом распроводится
			ИначеЕсли Действие = "unmark_deletion" Тогда
				Объект.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;
		После = ОписаниеОбъекта(Объект.Ссылка.ПолучитьОбъект(), МД, Вид);

		Результат = Новый Соответствие;
		Результат.Вставить("fix_id", Тело.Получить("fix_id"));
		Результат.Вставить("ref", После["ref"]);
		Результат.Вставить("before", До);
		Результат.Вставить("after", После);
		AIAPI_Запись.ЗаписатьЖурнал(ИД, Тело, "object:" + Действие, Объект.Ссылка, До, После, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Значение 1С -> значение для JSON (см. формат в начале модуля).
Функция ЗначениеВJSON(Значение) Экспорт
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат AIAPI_Общий.ДатаВСтроку(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Или ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат Неопределено;
	КонецЕсли;
	МД = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МД = Неопределено Тогда
		Возврат Строка(Значение);
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Соответствие;
	Результат.Вставить("_type", МД.ПолноеИмя());
	Если Метаданные.Перечисления.Содержит(МД) Тогда
		Индекс = Перечисления[МД.Имя].Индекс(Значение);
		Результат.Вставить("value", МД.ЗначенияПеречисления[Индекс].Имя);
	Иначе
		Результат.Вставить("ref", Строка(Значение.УникальныйИдентификатор()));
		Если Метаданные.ПланыСчетов.Содержит(МД) Тогда
			Результат.Вставить("code", Значение.Код);
		КонецЕсли;
	КонецЕсли;
	Результат.Вставить("presentation", Строка(Значение));
	Возврат Результат;
КонецФункции

// Значение из JSON -> значение 1С для реквизита с типом Типы (ОписаниеТипов или Неопределено).
Функция ЗначениеИзJSON(Данные, Типы, Поле) Экспорт
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = СсылкаИзJSON(Данные, Поле);
		Если Типы <> Неопределено И Не Типы.СодержитТип(ТипЗнч(Значение)) Тогда
			AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_value", СтрШаблон("%1: значение типа %2 сюда не подходит", Поле, Данные["_type"]));
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли Типы = Неопределено Тогда
		Возврат Данные;
	ИначеЕсли Данные = Неопределено Тогда
		Возврат Типы.ПривестиЗначение(Неопределено);
	ИначеЕсли ТипЗнч(Данные) = Тип("Строка") И Не Типы.СодержитТип(Тип("Строка")) Тогда
		Попытка
			Если Типы.СодержитТип(Тип("Дата")) Тогда
				Возврат AIAPI_Общий.СтрокаВДату(Данные);
			ИначеЕсли Типы.СодержитТип(Тип("Число")) Тогда
				Возврат Типы.ПривестиЗначение(Число(СтрЗаменить(Данные, ",", ".")));
			ИначеЕсли Типы.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
				Возврат Новый УникальныйИдентификатор(Данные);
			КонецЕсли;
		Исключение
			AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_value", СтрШаблон("%1: не удалось прочитать ""%2""", Поле, Данные));
		КонецПопытки;
	КонецЕсли;
	Возврат Типы.ПривестиЗначение(Данные);
КонецФункции

#КонецОбласти

#Область Описание

Функция ОписанияМетаданных(Коллекция, Вид)
	Результат = Новый Массив;
	Для Каждого МД Из Коллекция Цикл
		Результат.Добавить(ОписаниеМетаданных(МД, Вид));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОписаниеМетаданных(МД, Вид)
	Описание = Новый Соответствие;
	Описание.Вставить("name", МД.Имя);
	Описание.Вставить("synonym", МД.Синоним);
	Если Вид = "enum" Тогда
		Значения = Новый Массив;
		Для Каждого Значение Из МД.ЗначенияПеречисления Цикл
			Значения.Добавить(Новый Структура("name, synonym", Значение.Имя, Значение.Синоним));
		КонецЦикла;
		Описание.Вставить("values", Значения);
		Возврат Описание;
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Вид, "_register") Тогда
		Описание.Вставить("dimensions", ОписаниеПолей(МД.Измерения));
		Описание.Вставить("resources", ОписаниеПолей(МД.Ресурсы));
		Описание.Вставить("attributes", ОписаниеПолей(МД.Реквизиты));
		Описание.Вставить("period_field", ПолеПериода(МД, Вид));
		Возврат Описание;
	КонецЕсли;
	Описание.Вставить("writable", Вид = "catalog" Или Вид = "document");
	Описание.Вставить("standard", СтандартныеПоля(МД, Вид));
	Описание.Вставить("attributes", ОписаниеПолей(МД.Реквизиты));
	Если Вид = "document" Тогда
		Описание.Вставить("posting", МД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить);
	КонецЕсли;
	Таблицы = Новый Массив;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Таблица = Новый Соответствие;
		Таблица.Вставить("name", ТЧ.Имя);
		Таблица.Вставить("synonym", ТЧ.Синоним);
		Таблица.Вставить("attributes", ОписаниеПолей(ТЧ.Реквизиты));
		Таблицы.Добавить(Таблица);
	КонецЦикла;
	Описание.Вставить("tabular_sections", Таблицы);
	Возврат Описание;
КонецФункции

Функция ОписаниеПолей(Коллекция)
	Результат = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Типы = Новый Массив;
		Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
			МДТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Типы.Добавить(?(МДТипа = Неопределено, Строка(ТипПоля), МДТипа.ПолноеИмя()));
		КонецЦикла;
		Описание = Новый Соответствие;
		Описание.Вставить("name", Поле.Имя);
		Описание.Вставить("synonym", Поле.Синоним);
		Описание.Вставить("types", Типы);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Объект целиком: {_type, ref, presentation, deletion_mark, posted, standard, attributes, tables}.
Функция ОписаниеОбъекта(Объект, МД, Вид)
	Результат = Новый Соответствие;
	Результат.Вставить("_type", МД.ПолноеИмя());
	Результат.Вставить("ref", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("presentation", Строка(Объект.Ссылка));
	Результат.Вставить("deletion_mark", Объект.ПометкаУдаления);
	Если Вид = "document" Тогда
		Результат.Вставить("posted", Объект.Проведен);
	КонецЕсли;

	Стандартные = Новый Соответствие;
	Для Каждого Имя Из СтандартныеПоля(МД, Вид) Цикл
		Стандартные.Вставить(Имя, ЗначениеВJSON(Объект[Имя]));
	КонецЦикла;
	Результат.Вставить("standard", Стандартные);

	Реквизиты = Новый Соответствие;
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		Реквизиты.Вставить(Реквизит.Имя, ЗначениеВJSON(Объект[Реквизит.Имя]));
	КонецЦикла;
	Результат.Вставить("attributes", Реквизиты);

	Таблицы = Новый Соответствие;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
			СтрокаJSON = Новый Соответствие;
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				СтрокаJSON.Вставить(Реквизит.Имя, ЗначениеВJSON(СтрокаТЧ[Реквизит.Имя]));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Таблицы.Вставить(ТЧ.Имя, Строки);
	КонецЦикла;
	Результат.Вставить("tables", Таблицы);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Запись

Функция НовыйОбъект(МД, Вид, Данные)
	Если Вид = "document" Тогда
		Возврат Документы[МД.Имя].СоздатьДокумент();
	КонецЕсли;
	Стандартные = ?(Данные = Неопределено, Неопределено, Данные.Получить("standard"));
	Если МД.Иерархический И Стандартные <> Неопределено И Стандартные.Получить("ЭтоГруппа") = Истина Тогда
		Возврат Справочники[МД.Имя].СоздатьГруппу();
	КонецЕсли;
	Возврат Справочники[МД.Имя].СоздатьЭлемент();
КонецФункции

// data: {standard: {...}, attributes: {...}, tables: {ИмяТЧ: [строки]}}. Табличная часть заменяется целиком.
Процедура ПрименитьДанные(Объект, МД, Вид, Данные)
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Стандартные = Данные.Получить("standard");
	Если Стандартные <> Неопределено Тогда
		Допустимые = СтандартныеПоля(МД, Вид);
		Для Каждого КлючИЗначение Из Стандартные Цикл
			Имя = КлючИЗначение.Ключ;
			Значение = КлючИЗначение.Значение;
			Если Имя = "ЭтоГруппа" Тогда
				Продолжить; // задаётся только при создании
			ИначеЕсли Допустимые.Найти(Имя) = Неопределено Тогда
				AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_attribute", СтрШаблон("У %1 нет стандартного реквизита %2", МД.Имя, Имя));
			ИначеЕсли Имя = "Дата" Тогда
				Объект.Дата = AIAPI_Общий.СтрокаВДату(Значение);
			ИначеЕсли Имя = "Код" И Вид = "catalog" И МД.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Число Тогда
				Объект.Код = Число(Значение);
			ИначеЕсли Имя = "Родитель" И Значение = Неопределено Тогда
				Объект.Родитель = Справочники[МД.Имя].ПустаяСсылка();
			ИначеЕсли Имя = "Владелец" Или Имя = "Родитель" Тогда
				Объект[Имя] = ЗначениеИзJSON(Значение, Неопределено, Имя);
			Иначе
				Объект[Имя] = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Реквизиты = Данные.Получить("attributes");
	Если Реквизиты <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Реквизиты Цикл
			Реквизит = МД.Реквизиты.Найти(КлючИЗначение.Ключ);
			Если Реквизит = Неопределено Тогда
				AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_attribute", СтрШаблон("У %1 нет реквизита %2", МД.Имя, КлючИЗначение.Ключ));
			ИначеЕсли Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
				Продолжить;
			КонецЕсли;
			Объект[Реквизит.Имя] = ЗначениеИзJSON(КлючИЗначение.Значение, Реквизит.Тип, Реквизит.Имя);
		КонецЦикла;
	КонецЕсли;

	Таблицы = Данные.Получить("tables");
	Если Таблицы <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Таблицы Цикл
			ТЧ = МД.ТабличныеЧасти.Найти(КлючИЗначение.Ключ);
			Если ТЧ = Неопределено Тогда
				AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_attribute", СтрШаблон("У %1 нет табличной части %2", МД.Имя, КлючИЗначение.Ключ));
			КонецЕсли;
			Объект[ТЧ.Имя].Очистить();
			Для Каждого ДанныеСтроки Из КлючИЗначение.Значение Цикл
				НоваяСтрока = Объект[ТЧ.Имя].Добавить();
				Для Каждого Поле Из ДанныеСтроки Цикл
					Реквизит = ТЧ.Реквизиты.Найти(Поле.Ключ);
					Если Реквизит = Неопределено И Поле.Ключ = "НомерСтроки" Тогда
						Продолжить;
					ИначеЕсли Реквизит = Неопределено Тогда
						AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_attribute", СтрШаблон("В %1.%2 нет колонки %3", МД.Имя, ТЧ.Имя, Поле.Ключ));
					ИначеЕсли Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
						Продолжить;
					КонецЕсли;
					НоваяСтрока[Реквизит.Имя] = ЗначениеИзJSON(Поле.Значение, Реквизит.Тип, ТЧ.Имя + "." + Реквизит.Имя);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Возвращает объект к снимку (поле before предыдущего изменения): реквизиты, табличные части,
// пометку удаления и проведение.
Процедура ВосстановитьСнимок(Объект, МД, Вид, Снимок)
	Если ТипЗнч(Снимок) <> Тип("Соответствие") Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_request", "Для restore нужен snapshot");
	КонецЕсли;
	Пометка = Снимок.Получить("deletion_mark") = Истина;
	Если Объект.ПометкаУдаления И Не Пометка Тогда
		Объект.УстановитьПометкуУдаления(Ложь);
	КонецЕсли;

	Данные = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить("standard,attributes,tables", ",") Цикл
		Если Снимок.Получить(Часть) <> Неопределено Тогда
			Данные.Вставить(Часть, Снимок.Получить(Часть));
		КонецЕсли;
	КонецЦикла;
	ПрименитьДанные(Объект, МД, Вид, Данные);
	AIAPI_Метаданные.ПроверитьДатуЗапрета(Объект);

	Если Вид = "document" Тогда
		Если Снимок.Получить("posted") = Истина И Не Пометка Тогда
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		ИначеЕсли Объект.Проведен Тогда
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Иначе
		Объект.Записать();
	КонецЕсли;
	Если Пометка И Не Объект.ПометкаУдаления Тогда
		Объект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьВРежиме(Объект, Вид, Провести)
	Если Вид <> "document" Тогда
		Объект.Записать();
	ИначеЕсли Провести Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаксимумСтрок()
	Возврат 5000;
КонецФункции

Функция МаксимумСтрокЗапроса()
	Возврат 10000;
КонецФункции

Функция КоллекцияМетаданных(Вид)
	Если Вид = "catalog" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Вид = "document" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Вид = "information_register" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Вид = "accumulation_register" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли Вид = "accounting_register" Тогда
		Возврат Метаданные.РегистрыБухгалтерии;
	ИначеЕсли Вид = "chart_of_accounts" Тогда
		Возврат Метаданные.ПланыСчетов;
	ИначеЕсли Вид = "chart_of_characteristic_types" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Вид = "enum" Тогда
		Возврат Метаданные.Перечисления;
	КонецЕсли;
	AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_kind", "Неизвестный вид объекта " + Вид);
КонецФункции

Функция ОбъектМетаданных(Вид, Имя)
	МД = КоллекцияМетаданных(Вид).Найти(Имя);
	Если МД = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", СтрШаблон("В базе нет %1 %2", Вид, Имя));
	КонецЕсли;
	Возврат МД;
КонецФункции

Функция ЭтоСсылочныйВид(Вид)
	Возврат Вид = "catalog" Или Вид = "document" Или Вид = "chart_of_accounts" Или Вид = "chart_of_characteristic_types";
КонецФункции

Функция МенеджерПоМетаданным(МД)
	Если Метаданные.Справочники.Содержит(МД) Тогда
		Возврат Справочники[МД.Имя];
	ИначеЕсли Метаданные.Документы.Содержит(МД) Тогда
		Возврат Документы[МД.Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МД) Тогда
		Возврат ПланыСчетов[МД.Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МД) Тогда
		Возврат ПланыВидовХарактеристик[МД.Имя];
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МД) Тогда
		Возврат ПланыВидовРасчета[МД.Имя];
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(МД) Тогда
		Возврат ПланыОбмена[МД.Имя];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СуществующийОбъект(МД, УИД)
	Менеджер = МенеджерПоМетаданным(МД);
	Если Менеджер = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_kind", МД.ПолноеИмя() + ": у этого вида объектов нет ссылок");
	КонецЕсли;
	Объект = Менеджер.ПолучитьСсылку(УИДИзСтроки(УИД, "ref")).ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Объект не найден");
	КонецЕсли;
	Возврат Объект;
КонецФункции

// Стандартные реквизиты, которые читаются и меняются через API.
Функция СтандартныеПоля(МД, Вид)
	Поля = Новый Массив;
	Если Вид = "document" Тогда
		Поля.Добавить("Номер");
		Поля.Добавить("Дата");
		Возврат Поля;
	КонецЕсли;
	Если Вид = "catalog" Или Вид = "chart_of_characteristic_types" Тогда
		Если МД.ДлинаКода > 0 Тогда
			Поля.Добавить("Код");
		КонецЕсли;
		Если МД.ДлинаНаименования > 0 Тогда
			Поля.Добавить("Наименование");
		КонецЕсли;
		Если МД.Иерархический Тогда
			Поля.Добавить("Родитель");
		КонецЕсли;
	ИначеЕсли Вид = "chart_of_accounts" Тогда
		Поля.Добавить("Код");
		Поля.Добавить("Наименование");
		Поля.Добавить("Родитель");
	КонецЕсли;
	Если Вид = "catalog" И МД.Владельцы.Количество() > 0 Тогда
		Поля.Добавить("Владелец");
	КонецЕсли;
	Если Вид = "catalog" И МД.Иерархический И МД.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Поля.Добавить("ЭтоГруппа");
	КонецЕсли;
	Возврат Поля;
КонецФункции

// Поле периода для отбора from/to и сортировки, или пустая строка.
Функция ПолеПериода(МД, Вид)
	Если Вид = "document" Тогда
		Возврат "Дата";
	ИначеЕсли Вид = "accumulation_register" Или Вид = "accounting_register" Тогда
		Возврат "Период";
	ИначеЕсли Вид = "information_register"
		И МД.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Возврат "Период";
	КонецЕсли;
	Возврат "";
КонецФункции

// Тип поля для filter: стандартный реквизит (Код, Дата, Период, Регистратор...), реквизит,
// измерение или ресурс. Иначе 400.
Функция ТипПоляОтбора(МД, Вид, Имя)
	Для Каждого Стандартный Из МД.СтандартныеРеквизиты Цикл
		Если Стандартный.Имя = Имя Тогда
			Возврат Стандартный.Тип;
		КонецЕсли;
	КонецЦикла;
	Коллекции = Новый Массив;
	Коллекции.Добавить(МД.Реквизиты);
	Если СтрЗаканчиваетсяНа(Вид, "_register") Тогда
		Коллекции.Добавить(МД.Измерения);
		Коллекции.Добавить(МД.Ресурсы);
	КонецЕсли;
	Для Каждого Коллекция Из Коллекции Цикл
		Поле = Коллекция.Найти(Имя);
		Если Поле <> Неопределено Тогда
			Возврат Поле.Тип;
		КонецЕсли;
	КонецЦикла;
	AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_filter", СтрШаблон("У %1 нет поля %2", МД.Имя, Имя));
КонецФункции

Функция ОтборИзПараметра(Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Отбор = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_filter", "filter должен быть JSON-объектом");
	КонецПопытки;
	Если ТипЗнч(Отбор) <> Тип("Соответствие") Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_filter", "filter должен быть JSON-объектом");
	КонецЕсли;
	Возврат Отбор;
КонецФункции

Функция СсылкаИзJSON(Данные, Поле)
	ПолноеИмя = Данные.Получить("_type");
	МД = ?(ЗначениеЗаполнено(ПолноеИмя), Метаданные.НайтиПоПолномуИмени(ПолноеИмя), Неопределено);
	Если МД = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_value", СтрШаблон("%1: неизвестный _type %2", Поле, ПолноеИмя));
	КонецЕсли;
	Если Метаданные.Перечисления.Содержит(МД) Тогда
		Имя = Данные.Получить("value");
		Если Не ЗначениеЗаполнено(Имя) Или МД.ЗначенияПеречисления.Найти(Имя) = Неопределено Тогда
			AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_value", СтрШаблон("%1: в %2 нет значения %3", Поле, ПолноеИмя, Имя));
		КонецЕсли;
		Возврат Перечисления[МД.Имя][Имя];
	КонецЕсли;
	Менеджер = МенеджерПоМетаданным(МД);
	Если Менеджер = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_value", СтрШаблон("%1: %2 не ссылочный тип", Поле, ПолноеИмя));
	КонецЕсли;
	Если Метаданные.ПланыСчетов.Содержит(МД) И Не ЗначениеЗаполнено(Данные.Получить("ref")) Тогда
		Ссылка = Менеджер.НайтиПоКоду(Строка(Данные.Получить("code")));
	Иначе
		Ссылка = Менеджер.ПолучитьСсылку(УИДИзСтроки(Данные.Получить("ref"), Поле));
	КонецЕсли;
	Если Ссылка.Пустая() Или Ссылка.ПолучитьОбъект() = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_reference", Поле + ": объект не найден в базе");
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

// Параметр запроса: ссылка ({_type, ...}), массив, дата ("2026-09-30" или "2026-09-30T12:00:00") или как есть.
Функция ПараметрЗапроса(Значение, Имя)
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СсылкаИзJSON(Значение, Имя);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПараметрЗапроса(Элемент, Имя));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ПохожеНаДату(Значение) Тогда
		Попытка
			Возврат AIAPI_Общий.СтрокаВДату(Значение);
		Исключение
			Возврат Значение;
		КонецПопытки;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПохожеНаДату(Текст)
	Длина = СтрДлина(Текст);
	Если Длина <> 10 И Не (Длина = 19 И Сред(Текст, 11, 1) = "T") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-"
		И СтрДлина(СтрСоединить(СтрРазделить(Лев(Текст, 4), "0123456789"), "")) = 0;
КонецФункции

Функция УИДИзСтроки(Значение, Поле)
	Попытка
		Возврат Новый УникальныйИдентификатор(Значение);
	Исключение
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_reference", Поле + ": ожидается UUID");
	КонецПопытки;
КонецФункции

Функция ЧислоПараметра(Параметры, Имя, ПоУмолчанию)
	Значение = Параметры.Получить(Имя);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Макс(0, Цел(Число(Значение)));
	Исключение
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_request", Имя + " должен быть числом");
	КонецПопытки;
КонецФункции

#КонецОбласти
