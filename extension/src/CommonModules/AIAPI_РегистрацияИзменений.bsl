// Общий модуль AIAPI_РегистрацияИзменений (Сервер, привилегированный).
// Обработчики подписок на события. Каждая запись справочника или документа (включая
// проведение и пометку удаления) отмечается в регистре РегистрацияИзмененийAI;
// GET /changes?since= отдаёт эти отметки для инкрементальной синхронизации.
//
// Подписки (создаются в расширении):
//   AIAPI_ПриЗаписиСправочника  Источник: СправочникОбъект.Контрагенты, ДоговорыКонтрагентов,
//                               Номенклатура, Организации; Событие: ПриЗаписи
//                               -> AIAPI_РегистрацияИзменений.ПриЗаписиСправочника
//   AIAPI_ПриЗаписиДокумента    Источник: ДокументОбъект.<9 документов из AIAPI_Метаданные>;
//                               Событие: ПриЗаписи -> AIAPI_РегистрацияИзменений.ПриЗаписиДокумента
//   AIAPI_ПередУдалением        Источник: те же справочники и документы; Событие: ПередУдалением
//                               -> AIAPI_РегистрацияИзменений.ПередУдалением

Процедура ПриЗаписиСправочника(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Имя = AIAPI_Метаданные.ИмяСправочникаAPI(Источник.Метаданные().Имя);
	Если Имя <> Неопределено Тогда
		Зарегистрировать(Источник.Ссылка, "catalog", Имя, Источник.ПометкаУдаления, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписиДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Тип = AIAPI_Метаданные.ТипДокументаAPI(Источник.Метаданные().Имя);
	Если Тип <> Неопределено Тогда
		Зарегистрировать(Источник.Ссылка, "document", Тип, Источник.ПометкаУдаления, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ПередУдалением(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ИмяМетаданных = Источник.Метаданные().Имя;
	Тип = AIAPI_Метаданные.ТипДокументаAPI(ИмяМетаданных);
	Если Тип <> Неопределено Тогда
		Зарегистрировать(Источник.Ссылка, "document", Тип, Истина, Истина);
		Возврат;
	КонецЕсли;
	Имя = AIAPI_Метаданные.ИмяСправочникаAPI(ИмяМетаданных);
	Если Имя <> Неопределено Тогда
		Зарегистрировать(Источник.Ссылка, "catalog", Имя, Истина, Истина);
	КонецЕсли;
КонецПроцедуры

Процедура Зарегистрировать(Ссылка, Вид, Имя, Удален, УдаленФизически)
	Запись = РегистрыСведений.РегистрацияИзмененийAI.СоздатьМенеджерЗаписи();
	Запись.Ссылка = Строка(Ссылка.УникальныйИдентификатор());
	Запись.Вид = Вид;
	Запись.Имя = Имя;
	Запись.Счетчик = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись.Удален = Удален;
	Запись.УдаленФизически = УдаленФизически;
	Запись.Записать(Истина);
КонецПроцедуры
