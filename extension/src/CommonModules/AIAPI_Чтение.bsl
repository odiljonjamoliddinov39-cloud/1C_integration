// Общий модуль AIAPI_Чтение (Сервер, привилегированный).
// GET /ping, /catalogs/{name}, /documents/{type}, /ledger, /balances, /changes.
// Даты — ISO 8601, суммы — числа в UZS, ссылки — UUID строкой.

#Область ПрограммныйИнтерфейс

Функция Пинг() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("version", "1.0.0");
	Результат.Вставить("base_name", ИмяБазы());
	Результат.Вставить("platform", Новый СистемнаяИнформация().ВерсияПриложения);
	Результат.Вставить("configuration", Метаданные.Синоним + " " + Метаданные.Версия);
	Организация = Справочники.Организации.Выбрать();
	Если Организация.Следующий() Тогда
		Результат.Вставить("organization", Строка(Организация.Ссылка));
		Результат.Вставить("inn", Строка(Организация[AIAPI_Метаданные.Реквизиты().ИНН]));
	КонецЕсли;
	Результат.Вставить("closed_period_until", ДатаБезВремени(AIAPI_Метаданные.ОбщаяДатаЗапрета()));
	Возврат Результат;
КонецФункции

Функция Справочник(ИмяAPI, Параметры) Экспорт
	ИмяМетаданных = AIAPI_Метаданные.Справочники().Получить(ИмяAPI);
	Если ИмяМетаданных = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Неизвестный справочник " + ИмяAPI);
	КонецЕсли;
	Р = AIAPI_Метаданные.Реквизиты();
	МетаданныеСправочника = Метаданные.Справочники[ИмяМетаданных];

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Ссылки = AIAPI_Общий.СписокСсылок(Параметры);
	Если Ссылки <> Неопределено Тогда
		Условия.Добавить("Т.Ссылка В (&Ссылки)");
		Запрос.УстановитьПараметр("Ссылки", СсылкиСправочника(ИмяМетаданных, Ссылки));
	КонецЕсли;
	ИзмененоПосле = Параметры.Получить("changed_since");
	Если ЗначениеЗаполнено(ИзмененоПосле) Тогда
		Условия.Добавить("Т.Ссылка В (&Измененные)");
		Запрос.УстановитьПараметр("Измененные",
			СсылкиСправочника(ИмяМетаданных, ИзмененныеСсылки("catalog", ИмяAPI, ИзмененоПосле)));
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Справочник." + ИмяМетаданных + " КАК Т"
		+ ?(Условия.Количество() = 0, "", " ГДЕ " + СтрСоединить(Условия, " И "));

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка;
		Если Объект.ЭтоГруппа = Истина Тогда
			Продолжить;
		КонецЕсли;
		Эл = Новый Структура;
		Эл.Вставить("ref", AIAPI_Общий.УИД(Объект));
		Эл.Вставить("name", Строка(Объект.Наименование));
		Эл.Вставить("deleted", Объект.ПометкаУдаления);
		Если ИмяAPI = "counterparties" Или ИмяAPI = "organizations" Тогда
			Эл.Вставить("inn", СокрЛП(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.ИНН, "")));
		ИначеЕсли ИмяAPI = "contracts" Тогда
			Эл.Вставить("owner_ref", AIAPI_Общий.УИД(Объект.Владелец));
			Эл.Вставить("number", Строка(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.НомерДоговора, "")));
			Эл.Вставить("date", ДатаБезВремени(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.ДатаДоговора, Неопределено)));
		ИначеЕсли ИмяAPI = "items" Тогда
			Эл.Вставить("unit", Строка(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.ЕдиницаИзмерения, "")));
			Эл.Вставить("price", ЦенаНоменклатуры(Объект, МетаданныеСправочника));
			Эл.Вставить("vat_rate", AIAPI_Метаданные.СтавкаЧислом(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.СтавкаНДС, Неопределено)));
			Эл.Вставить("ikpu_code", СокрЛП(Строка(ЗначениеРеквизита(Объект, МетаданныеСправочника, Р.ИКПУ, ""))));
		КонецЕсли;
		Элементы.Добавить(Эл);
	КонецЦикла;
	Возврат Новый Структура("name, items", ИмяAPI, Элементы);
КонецФункции

Функция Документы(ТипAPI, Параметры) Экспорт
	ИмяМетаданных = AIAPI_Метаданные.ТипыДокументов().Получить(ТипAPI);
	Если ИмяМетаданных = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Неизвестный тип документа " + ТипAPI);
	КонецЕсли;
	Запрос = Новый Запрос;
	Ссылки = AIAPI_Общий.СписокСсылок(Параметры);
	Если Ссылки <> Неопределено Тогда
		Условие = "Д.Ссылка В (&Ссылки)";
		Массив = Новый Массив;
		Для Каждого УИД Из Ссылки Цикл
			Массив.Добавить(AIAPI_Метаданные.СсылкаДокумента(ТипAPI, УИД));
		КонецЦикла;
		Запрос.УстановитьПараметр("Ссылки", Массив);
	Иначе
		Условие = "Д.Дата МЕЖДУ &Начало И &Конец";
		Запрос.УстановитьПараметр("Начало", НачалоДня(AIAPI_Общий.СтрокаВДату(Параметры.Получить("from"), '00010101')));
		Запрос.УстановитьПараметр("Конец", КонецДня(AIAPI_Общий.СтрокаВДату(Параметры.Получить("to"), ТекущаяДатаСеанса())));
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК Ссылка ИЗ Документ." + ИмяМетаданных + " КАК Д ГДЕ " + Условие
		+ " УПОРЯДОЧИТЬ ПО Д.Дата";

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Добавить(ОписаниеДокумента(Выборка.Ссылка, ТипAPI));
	КонецЦикла;
	Возврат Новый Структура("type, items", ТипAPI, Элементы);
КонецФункции

Функция Проводки(Параметры) Экспорт
	Запрос = Новый Запрос;
	Ссылки = AIAPI_Общий.СписокСсылок(Параметры);
	Если Ссылки <> Неопределено Тогда
		Регистраторы = Новый Массив;
		Для Каждого УИД Из Ссылки Цикл
			Для Каждого Тип Из AIAPI_Метаданные.ТипыДокументов() Цикл
				Регистраторы.Добавить(AIAPI_Метаданные.СсылкаДокумента(Тип.Ключ, УИД));
			КонецЦикла;
		КонецЦикла;
		Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
		Источник = "РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , Регистратор В (&Регистраторы), , )";
	Иначе
		Запрос.УстановитьПараметр("Начало", НачалоДня(AIAPI_Общий.СтрокаВДату(Параметры.Получить("from"), '00010101')));
		Запрос.УстановитьПараметр("Конец", КонецДня(AIAPI_Общий.СтрокаВДату(Параметры.Получить("to"), ТекущаяДатаСеанса())));
		Источник = "РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&Начало, &Конец, , , )";
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Регистратор КАК Регистратор,
	|	Д.Период КАК Период,
	|	Д.СчетДт.Код КАК СчетДт,
	|	Д.СчетКт.Код КАК СчетКт,
	|	Д.Сумма КАК Сумма,
	|	Д.КоличествоДт КАК КоличествоДт,
	|	Д.КоличествоКт КАК КоличествоКт,
	|	Д.СубконтоДт1 КАК СубконтоДт1, Д.СубконтоДт2 КАК СубконтоДт2, Д.СубконтоДт3 КАК СубконтоДт3,
	|	Д.СубконтоКт1 КАК СубконтоКт1, Д.СубконтоКт2 КАК СубконтоКт2, Д.СубконтоКт3 КАК СубконтоКт3
	|ИЗ
	|	" + Источник + " КАК Д
	|УПОРЯДОЧИТЬ ПО
	|	Д.Период";
	// ПРОВЕРИТЬ: ресурс количества в плане счетов Хозрасчетный называется «Количество».

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Эл = Новый Структура;
		Эл.Вставить("document_ref", AIAPI_Общий.УИД(Выборка.Регистратор));
		Эл.Вставить("date", AIAPI_Общий.ДатаВСтроку(Выборка.Период));
		Эл.Вставить("dt", Строка(Выборка.СчетДт));
		Эл.Вставить("kt", Строка(Выборка.СчетКт));
		Эл.Вставить("amount", Выборка.Сумма);
		Эл.Вставить("subconto", Новый Структура("dt, kt",
			Субконто(Выборка.СубконтоДт1, Выборка.СубконтоДт2, Выборка.СубконтоДт3, Выборка.КоличествоДт),
			Субконто(Выборка.СубконтоКт1, Выборка.СубконтоКт2, Выборка.СубконтоКт3, Выборка.КоличествоКт)));
		Элементы.Добавить(Эл);
	КонецЦикла;
	Возврат Новый Структура("items", Элементы);
КонецФункции

// Остатки на начало дня date (без оборотов этого дня) по счетам и субконто.
Функция Остатки(Параметры) Экспорт
	Дата = AIAPI_Общий.СтрокаВДату(Параметры.Получить("date"), ТекущаяДатаСеанса());
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", Новый Граница(НачалоДня(Дата), ВидГраницы.Исключая));
	УсловиеСчета = "";
	Счет = Параметры.Получить("account");
	Если ЗначениеЗаполнено(Счет) Тогда
		УсловиеСчета = "Счет В ИЕРАРХИИ (&Счет)";
		Запрос.УстановитьПараметр("Счет", ПланыСчетов.Хозрасчетный.НайтиПоКоду(Счет));
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Счет.Код КАК Счет,
	|	О.Субконто1 КАК Субконто1, О.Субконто2 КАК Субконто2, О.Субконто3 КАК Субконто3,
	|	О.СуммаОстатокДт КАК Дт,
	|	О.СуммаОстатокКт КАК Кт,
	|	ЕСТЬNULL(О.КоличествоОстатокДт, 0) - ЕСТЬNULL(О.КоличествоОстатокКт, 0) КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница, " + УсловиеСчета + ", , ) КАК О";

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Эл = Новый Структура;
		Эл.Вставить("account", Строка(Выборка.Счет));
		Эл.Вставить("subconto", Субконто(Выборка.Субконто1, Выборка.Субконто2, Выборка.Субконто3, Неопределено));
		Эл.Вставить("debit", Выборка.Дт);
		Эл.Вставить("credit", Выборка.Кт);
		Эл.Вставить("quantity", ?(Выборка.Количество = 0, Неопределено, Выборка.Количество));
		Элементы.Добавить(Эл);
	КонецЦикла;
	Возврат Новый Структура("date, items", ДатаБезВремени(Дата), Элементы);
КонецФункции

// Изменённые объекты после курсора since (миллисекунды UTC строкой).
// Возвращает записи с перекрытием 2 минуты: долгие транзакции могли зафиксироваться позже
// своей отметки времени; повторная загрузка того же объекта безопасна.
Функция Изменения(Параметры) Экспорт
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Курсор = Формат(Сейчас, "ЧГ=");
	Элементы = Новый Массив;
	С = Параметры.Получить("since");
	Если Не ЗначениеЗаполнено(С) Тогда
		Возврат Новый Структура("cursor, items", Курсор, Элементы);
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Ссылка, Р.Вид КАК Вид, Р.Имя КАК Имя, Р.Удален КАК Удален, Р.УдаленФизически КАК УдаленФизически
	|ИЗ
	|	РегистрСведений.РегистрацияИзмененийAI КАК Р
	|ГДЕ
	|	Р.Счетчик > &С
	|УПОРЯДОЧИТЬ ПО
	|	Р.Счетчик");
	Запрос.УстановитьПараметр("С", Число(С) - 120000);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Эл = Новый Структура("kind, ref, deleted, removed", Выборка.Вид, Выборка.Ссылка, Выборка.Удален, Выборка.УдаленФизически);
		Эл.Вставить(?(Выборка.Вид = "document", "type", "name"), Выборка.Имя);
		Элементы.Добавить(Эл);
	КонецЦикла;
	Возврат Новый Структура("cursor, items", Курсор, Элементы);
КонецФункции

// Описание одного документа для API (шапка + строки).
Функция ОписаниеДокумента(Ссылка, ТипAPI) Экспорт
	Р = AIAPI_Метаданные.Реквизиты();
	МД = Ссылка.Метаданные();
	Результат = Новый Структура;
	Результат.Вставить("ref", AIAPI_Общий.УИД(Ссылка));
	Результат.Вставить("type", ТипAPI);
	Результат.Вставить("number", СокрЛП(Ссылка.Номер));
	Результат.Вставить("date", AIAPI_Общий.ДатаВСтроку(Ссылка.Дата));
	Результат.Вставить("posted", Ссылка.Проведен);
	Результат.Вставить("deleted", Ссылка.ПометкаУдаления);
	Результат.Вставить("counterparty_ref", AIAPI_Общий.УИД(ЗначениеРеквизита(Ссылка, МД, Р.Контрагент, Неопределено)));
	Результат.Вставить("contract_ref", AIAPI_Общий.УИД(ЗначениеРеквизита(Ссылка, МД, Р.Договор, Неопределено)));
	Результат.Вставить("warehouse_ref", AIAPI_Общий.УИД(ЗначениеРеквизита(Ссылка, МД, Р.Склад, Неопределено)));
	Результат.Вставить("amount", ЗначениеРеквизита(Ссылка, МД, Р.СуммаДокумента, 0));

	Строки = Новый Массив;
	СуммаНДС = 0;
	ТЧ = МД.ТабличныеЧасти.Найти(Р.ТабличнаяЧасть);
	Если ТЧ <> Неопределено Тогда
		ВключаетНДС = ЗначениеРеквизита(Ссылка, МД, Р.СуммаВключаетНДС, Ложь) = Истина;
		Для Каждого СтрокаТЧ Из Ссылка[Р.ТабличнаяЧасть] Цикл
			НДС = ЗначениеРеквизита(СтрокаТЧ, ТЧ, Р.СуммаНДССтроки, 0);
			Сумма = ЗначениеРеквизита(СтрокаТЧ, ТЧ, Р.СуммаСтроки, 0);
			Эл = Новый Структура;
			Эл.Вставить("item_ref", AIAPI_Общий.УИД(СтрокаТЧ.Номенклатура));
			Эл.Вставить("quantity", ЗначениеРеквизита(СтрокаТЧ, ТЧ, Р.Количество, 0));
			Эл.Вставить("price", ЗначениеРеквизита(СтрокаТЧ, ТЧ, Р.ЦенаСтроки, 0));
			Эл.Вставить("amount", ?(ВключаетНДС, Сумма - НДС, Сумма)); // всегда без НДС
			Эл.Вставить("vat_rate", AIAPI_Метаданные.СтавкаЧислом(ЗначениеРеквизита(СтрокаТЧ, ТЧ, Р.СтавкаНДССтроки, Неопределено)));
			Эл.Вставить("vat_amount", НДС);
			Эл.Вставить("warehouse_ref", Результат.warehouse_ref);
			Строки.Добавить(Эл);
			СуммаНДС = СуммаНДС + НДС;
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("vat", СуммаНДС);
	Результат.Вставить("rows", Строки);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяБазы()
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		Пара = СтрРазделить(Часть, "=");
		Если Пара.Количество() = 2 И (НРег(Пара[0]) = "file" Или НРег(Пара[0]) = "ref") Тогда
			Значение = СтрЗаменить(Пара[1], """", "");
			Части = СтрРазделить(СтрЗаменить(Значение, "/", "\"), "\", Ложь);
			Возврат Части[Части.ВГраница()];
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаСоединения;
КонецФункции

Функция ДатаБезВремени(Дата)
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");
КонецФункции

Функция ЗначениеРеквизита(Объект, МетаданныеОбъекта, Имя, ПоУмолчанию)
	Если МетаданныеОбъекта.Реквизиты.Найти(Имя) = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Объект[Имя];
КонецФункции

Функция ЦенаНоменклатуры(Ссылка, МетаданныеСправочника)
	// ПРОВЕРИТЬ: если цена хранится в регистре цен, заменить на срез последних этого регистра.
	Возврат ЗначениеРеквизита(Ссылка, МетаданныеСправочника, AIAPI_Метаданные.Реквизиты().Цена, 0);
КонецФункции

Функция СсылкиСправочника(ИмяМетаданных, УИДы)
	Массив = Новый Массив;
	Если УИДы = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;
	Для Каждого УИД Из УИДы Цикл
		Массив.Добавить(Справочники[ИмяМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД)));
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ИзмененныеСсылки(Вид, Имя, После)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Р.Ссылка КАК Ссылка
	|ИЗ РегистрСведений.РегистрацияИзмененийAI КАК Р
	|ГДЕ Р.Вид = &Вид И Р.Имя = &Имя И Р.Счетчик > &После");
	Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("После", Число(После) - 120000);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Значения субконто -> {counterparty_ref, contract_ref, item_ref, warehouse_ref, quantity}.
Функция Субконто(З1, З2, З3, Количество)
	Результат = Новый Структура;
	Значения = Новый Массив;
	Значения.Добавить(З1);
	Значения.Добавить(З2);
	Значения.Добавить(З3);
	Для Каждого Значение Из Значения Цикл
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Тип = ТипЗнч(Значение);
		Если Тип = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат.Вставить("counterparty_ref", AIAPI_Общий.УИД(Значение));
		ИначеЕсли Тип = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Результат.Вставить("contract_ref", AIAPI_Общий.УИД(Значение));
		ИначеЕсли Тип = Тип("СправочникСсылка.Номенклатура") Тогда
			Результат.Вставить("item_ref", AIAPI_Общий.УИД(Значение));
		ИначеЕсли Тип = Тип("СправочникСсылка.Склады") Тогда
			Результат.Вставить("warehouse_ref", AIAPI_Общий.УИД(Значение));
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Количество) Тогда
		Результат.Вставить("quantity", Количество);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
