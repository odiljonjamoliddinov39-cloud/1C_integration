// Общий модуль AIAPI_Запись (Сервер, привилегированный).
// POST /invoices, /invoices/{id}/post, /fixes; GET /fixes/{id}.
//
// Правила для каждой записи:
//   * нужен approval_id, выданный бэкендом; без него — 400;
//   * повтор того же approval_id не меняет базу, а возвращает сохранённый результат
//     (агент может повторить команду после обрыва связи);
//   * всё изменение — одна транзакция; любая ошибка откатывает его целиком;
//   * запись в регистр ЖурналИзмененийAI: кто, когда, объект, до, после;
//   * закрытый период (дата запрета изменения) — 409, база не меняется.

#Область ПрограммныйИнтерфейс

Функция СоздатьСчетФактуру(Тело) Экспорт
	ИД = ИдентификаторОдобрения(Тело);
	Предыдущий = РезультатОдобрения(ИД);
	Если Предыдущий <> Неопределено Тогда
		Возврат Предыдущий;
	КонецЕсли;

	Р = AIAPI_Метаданные.Реквизиты();
	ИмяДокумента = AIAPI_Метаданные.ТипыДокументов().Получить("invoice_out");
	МД = Метаданные.Документы[ИмяДокумента];

	НачатьТранзакцию();
	Попытка
		Док = Документы[ИмяДокумента].СоздатьДокумент();
		Док.Дата = AIAPI_Общий.СтрокаВДату(Тело["date"]) + 12 * 3600;
		Организация = Справочники.Организации.Выбрать();
		Если Организация.Следующий() И AIAPI_Метаданные.ЕстьРеквизит(МД, Р.Организация) Тогда
			Док[Р.Организация] = Организация.Ссылка;
		КонецЕсли;
		Док[Р.Контрагент] = Обязательно(AIAPI_Метаданные.СсылкаСправочника("counterparties", Тело["buyer_ref"]), "buyer_ref");
		Док[Р.Договор] = Обязательно(AIAPI_Метаданные.СсылкаСправочника("contracts", Тело["contract_ref"]), "contract_ref");
		Если AIAPI_Метаданные.ЕстьРеквизит(МД, Р.СуммаВключаетНДС) Тогда
			Док[Р.СуммаВключаетНДС] = Ложь; // суммы строк приходят без НДС
		КонецЕсли;
		Пример = AIAPI_Метаданные.ПримерСтавки(ИмяДокумента);
		Итого = 0;
		Для Каждого ДанныеСтроки Из Тело["rows"] Цикл
			НоваяСтрока = Док[Р.ТабличнаяЧасть].Добавить();
			НоваяСтрока.Номенклатура = Обязательно(AIAPI_Метаданные.СсылкаСправочника("items", ДанныеСтроки["item_ref"]), "item_ref");
			НоваяСтрока[Р.Количество] = Ч(ДанныеСтроки["quantity"]);
			НоваяСтрока[Р.ЦенаСтроки] = Ч(ДанныеСтроки["price"]);
			НоваяСтрока[Р.СуммаСтроки] = Ч(ДанныеСтроки["amount"]);
			НоваяСтрока[Р.СтавкаНДССтроки] = AIAPI_Метаданные.СтавкаИзЧисла(Ч(ДанныеСтроки["vat_rate"]), Пример);
			НоваяСтрока[Р.СуммаНДССтроки] = Ч(ДанныеСтроки["vat"]);
			Итого = Итого + Ч(ДанныеСтроки["amount"]) + Ч(ДанныеСтроки["vat"]);
		КонецЦикла;
		Если AIAPI_Метаданные.ЕстьРеквизит(МД, Р.СуммаДокумента) Тогда
			Док[Р.СуммаДокумента] = Итого;
		КонецЕсли;
		Если AIAPI_Метаданные.ЕстьРеквизит(МД, "Комментарий") Тогда
			Док.Комментарий = "Создан из веб-приложения, счёт №" + Формат(Тело["app_invoice_id"], "ЧГ=");
		КонецЕсли;
		AIAPI_Метаданные.ПроверитьДатуЗапрета(Док);
		Док.Записать(РежимЗаписиДокумента.Запись);

		Описание = AIAPI_Чтение.ОписаниеДокумента(Док.Ссылка, "invoice_out");
		Результат = Новый Структура("ref, number, date, total, vat, posted",
			Описание.ref, Описание.number, Описание.date, Итого, Описание.vat, Ложь);
		ЗаписатьЖурнал(ИД, Тело, "create_invoice", Док.Ссылка, Неопределено, Описание, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ПровестиСчетФактуру(Тело) Экспорт
	ИД = ИдентификаторОдобрения(Тело);
	Предыдущий = РезультатОдобрения(ИД);
	Если Предыдущий <> Неопределено Тогда
		Возврат Предыдущий;
	КонецЕсли;
	Ссылка = AIAPI_Метаданные.СсылкаДокумента("invoice_out", Тело["ref"]);
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Счёт-фактура не найден");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Док = Ссылка.ПолучитьОбъект();
		AIAPI_Метаданные.ПроверитьДатуЗапрета(Док);
		До = Новый Структура("posted", Док.Проведен);
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Результат = Новый Структура("ref, posted", Тело["ref"], Истина);
		ЗаписатьЖурнал(ИД, Тело, "post_invoice", Ссылка, До, Результат, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Применяет одно одобренное исправление. Тело: {approval_id, fix_id, type, object, changes, reverse_of}.
Функция ПрименитьИсправление(Тело) Экспорт
	ИД = ИдентификаторОдобрения(Тело);
	Предыдущий = РезультатОдобрения(ИД);
	Если Предыдущий <> Неопределено Тогда
		Возврат Предыдущий;
	КонецЕсли;

	Вид = Тело["type"];
	Объект = Тело["object"];
	Изменения = Тело["changes"];

	НачатьТранзакцию();
	Попытка
		Если Вид = "restore" Тогда
			ДоПосле = Восстановить(Тело["reverse_of"], Объект, Изменения);
		ИначеЕсли Вид = "fill_field" Тогда
			ДоПосле = ЗаполнитьРеквизит(Объект, Изменения["field"], Изменения["value"]);
		ИначеЕсли Вид = "repost" Тогда
			ДоПосле = Перепровести(Объект);
		ИначеЕсли Вид = "correct_vat" Тогда
			ДоПосле = ИсправитьСтавкуНДС(Объект, Изменения["rows"]);
		ИначеЕсли Вид = "reverse_duplicate" Тогда
			ДоПосле = СторнироватьДубль(Объект);
		ИначеЕсли Вид = "merge_counterparties" Тогда
			ДоПосле = ОбъединитьКонтрагентов(Объект["ref"], Изменения["main_ref"], Изменения["documents"]);
		Иначе
			AIAPI_Общий.ВызватьОшибкуAPI(400, "unknown_fix", "Неизвестный тип исправления " + Вид);
		КонецЕсли;
		Результат = Новый Структура("fix_id, before, after", Тело["fix_id"], ДоПосле.До, ДоПосле.После);
		ЗаписатьЖурнал(ИД, Тело, "fix:" + Вид, Объект["ref"], ДоПосле.До, ДоПосле.После, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Сохранённый результат по approval_id (Соответствие) или Неопределено.
Функция РезультатОдобрения(ИД) Экспорт
	Менеджер = РегистрыСведений.ЖурналИзмененийAI.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторОдобрения = ИД;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИзJSON(Менеджер.Результат);
КонецФункции

#КонецОбласти

#Область Исправления

Функция ЗаполнитьРеквизит(Объект, Поле, Значение)
	Р = AIAPI_Метаданные.Реквизиты();
	Вид = Объект["kind"];
	Если Вид = "counterparty" И Поле = "inn" Тогда
		Изменяемый = AIAPI_Метаданные.СсылкаСправочника("counterparties", Объект["ref"]).ПолучитьОбъект();
		Реквизит = Р.ИНН;
		Новое = Строка(Значение);
	ИначеЕсли Вид = "item" И Поле = "ikpu_code" Тогда
		Изменяемый = AIAPI_Метаданные.СсылкаСправочника("items", Объект["ref"]).ПолучитьОбъект();
		Реквизит = Р.ИКПУ;
		Новое = Строка(Значение);
	ИначеЕсли Вид = "item" И Поле = "vat_rate" Тогда
		Изменяемый = AIAPI_Метаданные.СсылкаСправочника("items", Объект["ref"]).ПолучитьОбъект();
		Реквизит = Р.СтавкаНДС;
		Новое = AIAPI_Метаданные.СтавкаИзЧисла(Ч(Значение), Изменяемый[Реквизит]);
	ИначеЕсли Вид = "document" И Поле = "contract_ref" Тогда
		Изменяемый = AIAPI_Метаданные.СсылкаДокумента(Объект["type"], Объект["ref"]).ПолучитьОбъект();
		Реквизит = Р.Договор;
		Новое = AIAPI_Метаданные.СсылкаСправочника("contracts", Значение);
	Иначе
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_field", "Поле " + Поле + " нельзя заполнить у " + Вид);
	КонецЕсли;
	Если Изменяемый = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Объект не найден");
	КонецЕсли;
	ПроверитьПериод(Изменяемый);

	До = Новый Структура("field, value", Поле, ЗначениеAPI(Изменяемый[Реквизит]));
	Изменяемый[Реквизит] = Новое;
	ЗаписатьОбъект(Изменяемый);
	После = Новый Структура("field, value", Поле, ЗначениеAPI(Изменяемый[Реквизит]));
	Возврат Новый Структура("До, После", До, После);
КонецФункции

Функция Перепровести(Объект)
	Док = ДокументОбъект(Объект);
	До = Новый Структура("posted", Док.Проведен);
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Новый Структура("До, После", До, Новый Структура("posted", Истина));
КонецФункции

Функция ИсправитьСтавкуНДС(Объект, Строки)
	Р = AIAPI_Метаданные.Реквизиты();
	Док = ДокументОбъект(Объект);
	ВключаетНДС = AIAPI_Метаданные.ЕстьРеквизит(Док.Метаданные(), Р.СуммаВключаетНДС) И Док[Р.СуммаВключаетНДС] = Истина;
	БылиСтроки = Новый Массив;
	СталиСтроки = Новый Массив;
	ТЧ = Док[Р.ТабличнаяЧасть];
	Для Каждого Исправление Из Строки Цикл
		Номер = Ч(Исправление["row"]);
		Если Номер < 1 Или Номер > ТЧ.Количество() Тогда
			AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_row", "Нет строки " + Номер);
		КонецЕсли;
		СтрокаТЧ = ТЧ[Номер - 1];
		Ставка = Ч(Исправление["vat_rate"]);
		БылиСтроки.Добавить(Новый Структура("row, vat_rate", Номер, AIAPI_Метаданные.СтавкаЧислом(СтрокаТЧ[Р.СтавкаНДССтроки])));
		СтрокаТЧ[Р.СтавкаНДССтроки] = AIAPI_Метаданные.СтавкаИзЧисла(Ставка, СтрокаТЧ[Р.СтавкаНДССтроки]);
		Сумма = СтрокаТЧ[Р.СуммаСтроки];
		СтрокаТЧ[Р.СуммаНДССтроки] = Окр(?(ВключаетНДС, Сумма * Ставка / (100 + Ставка), Сумма * Ставка / 100), 2);
		СталиСтроки.Добавить(Новый Структура("row, vat_rate", Номер, Ставка));
	КонецЦикла;
	ЗаписатьОбъект(Док);
	Возврат Новый Структура("До, После", Новый Структура("rows", БылиСтроки), Новый Структура("rows", СталиСтроки));
КонецФункции

Функция СторнироватьДубль(Объект)
	Док = ДокументОбъект(Объект);
	До = Новый Структура("posted, deletion_mark", Док.Проведен, Док.ПометкаУдаления);
	Если Док.Проведен Тогда
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	Док.УстановитьПометкуУдаления(Истина);
	Возврат Новый Структура("До, После", До, Новый Структура("posted, deletion_mark", Ложь, Истина));
КонецФункции

Функция ОбъединитьКонтрагентов(ДубльУИД, ОсновнойУИД, СписокДокументов)
	Р = AIAPI_Метаданные.Реквизиты();
	Дубль = AIAPI_Метаданные.СсылкаСправочника("counterparties", ДубльУИД);
	Основной = AIAPI_Метаданные.СсылкаСправочника("counterparties", ОсновнойУИД);
	Если Дубль.ПолучитьОбъект() = Неопределено Или Основной.ПолучитьОбъект() = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Контрагент не найден");
	КонецЕсли;

	// Договоры дубля переходят к основному контрагенту.
	Договоры = Новый Массив;
	ИмяДоговоров = AIAPI_Метаданные.Справочники().Получить("contracts");
	Выборка = Справочники[ИмяДоговоров].Выбрать(, Дубль);
	Пока Выборка.Следующий() Цикл
		Договор = Выборка.ПолучитьОбъект();
		Договор.Владелец = Основной;
		Договор.Записать();
		Договоры.Добавить(AIAPI_Общий.УИД(Договор.Ссылка));
	КонецЦикла;

	Перенесены = Новый Массив;
	Для Каждого Описание Из СписокДокументов Цикл
		Док = ДокументОбъект(Описание);
		Док[Р.Контрагент] = Основной;
		ЗаписатьОбъект(Док);
		Перенесены.Добавить(Новый Структура("type, ref", Описание["type"], Описание["ref"]));
	КонецЦикла;

	ОбъектДубля = Дубль.ПолучитьОбъект();
	ОбъектДубля.УстановитьПометкуУдаления(Истина);

	До = Новый Структура("counterparty_ref, documents, contracts, deletion_mark", ДубльУИД, Перенесены, Договоры, Ложь);
	После = Новый Структура("counterparty_ref, documents, contracts, deletion_mark", ОсновнойУИД, Перенесены, Договоры, Истина);
	Возврат Новый Структура("До, После", До, После);
КонецФункции

// Отмена исправления: возвращает значения из before_json исходного исправления.
Функция Восстановить(ИсходныйВид, Объект, Изменения)
	Снимок = Изменения["restore"];
	Если ИсходныйВид = "fill_field" Тогда
		Возврат ЗаполнитьРеквизитБезПроверки(Объект, Снимок["field"], Снимок["value"]);
	ИначеЕсли ИсходныйВид = "correct_vat" Тогда
		Возврат ИсправитьСтавкуНДС(Объект, Снимок["rows"]);
	ИначеЕсли ИсходныйВид = "reverse_duplicate" Тогда
		Док = ДокументОбъект(Объект);
		До = Новый Структура("posted, deletion_mark", Док.Проведен, Док.ПометкаУдаления);
		Док.УстановитьПометкуУдаления(Снимок["deletion_mark"] = Истина);
		Если Снимок["posted"] = Истина Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Возврат Новый Структура("До, После", До, Снимок);
	ИначеЕсли ИсходныйВид = "merge_counterparties" Тогда
		Р = AIAPI_Метаданные.Реквизиты();
		Дубль = AIAPI_Метаданные.СсылкаСправочника("counterparties", Снимок["counterparty_ref"]);
		ИмяДоговоров = AIAPI_Метаданные.Справочники().Получить("contracts");
		Для Каждого УИД Из Снимок["contracts"] Цикл
			Договор = AIAPI_Метаданные.СсылкаСправочника("contracts", УИД).ПолучитьОбъект();
			Договор.Владелец = Дубль;
			Договор.Записать();
		КонецЦикла;
		Для Каждого Описание Из Снимок["documents"] Цикл
			Док = ДокументОбъект(Описание);
			Док[Р.Контрагент] = Дубль;
			ЗаписатьОбъект(Док);
		КонецЦикла;
		Дубль.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
		Возврат Новый Структура("До, После", Новый Структура("deletion_mark", Истина), Снимок);
	ИначеЕсли ИсходныйВид = "repost" Тогда
		Возврат Новый Структура("До, После", Новый Структура, Снимок);
	КонецЕсли;
	AIAPI_Общий.ВызватьОшибкуAPI(400, "unknown_fix", "Нельзя отменить " + ИсходныйВид);
КонецФункции

// Как ЗаполнитьРеквизит, но допускает пустое значение (возврат к исходному состоянию).
Функция ЗаполнитьРеквизитБезПроверки(Объект, Поле, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат ЗаполнитьРеквизит(Объект, Поле, Значение);
	КонецЕсли;
	Р = AIAPI_Метаданные.Реквизиты();
	Если Объект["kind"] = "document" Тогда
		Изменяемый = ДокументОбъект(Объект);
		Реквизит = Р.Договор;
		Пустое = Справочники[AIAPI_Метаданные.Справочники().Получить("contracts")].ПустаяСсылка();
	Иначе
		ИмяAPI = ?(Объект["kind"] = "counterparty", "counterparties", "items");
		Изменяемый = AIAPI_Метаданные.СсылкаСправочника(ИмяAPI, Объект["ref"]).ПолучитьОбъект();
		Реквизит = ?(Поле = "inn", Р.ИНН, ?(Поле = "ikpu_code", Р.ИКПУ, Р.СтавкаНДС));
		Пустое = Неопределено;
	КонецЕсли;
	До = Новый Структура("field, value", Поле, ЗначениеAPI(Изменяемый[Реквизит]));
	Если Пустое = Неопределено Тогда
		Изменяемый[Реквизит] = Новый(ТипЗнч(Изменяемый[Реквизит]));
	Иначе
		Изменяемый[Реквизит] = Пустое;
	КонецЕсли;
	ЗаписатьОбъект(Изменяемый);
	Возврат Новый Структура("До, После", До, Новый Структура("field, value", Поле, Неопределено));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Также используется AIAPI_Объекты.
Функция ИдентификаторОдобрения(Тело) Экспорт
	ИД = Тело.Получить("approval_id");
	Если Не ЗначениеЗаполнено(ИД) Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "approval_required", "Нужен approval_id, выданный бэкендом");
	КонецЕсли;
	Попытка
		Новый УникальныйИдентификатор(ИД);
	Исключение
		AIAPI_Общий.ВызватьОшибкуAPI(400, "approval_required", "approval_id должен быть UUID");
	КонецПопытки;
	Возврат ИД;
КонецФункции

Функция ДокументОбъект(Описание)
	Ссылка = AIAPI_Метаданные.СсылкаДокумента(Описание["type"], Описание["ref"]);
	Док = Ссылка.ПолучитьОбъект();
	Если Док = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(404, "not_found", "Документ не найден");
	КонецЕсли;
	ПроверитьПериод(Док);
	Возврат Док;
КонецФункции

Процедура ПроверитьПериод(Объект)
	Если Метаданные.Документы.Содержит(Объект.Метаданные()) Тогда
		AIAPI_Метаданные.ПроверитьДатуЗапрета(Объект);
	КонецЕсли;
КонецПроцедуры

// Документ перепроводится, если был проведён; справочник просто записывается.
Процедура ЗаписатьОбъект(Объект)
	Если Метаданные.Документы.Содержит(Объект.Метаданные()) Тогда
		Объект.Записать(?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
	Иначе
		Объект.Записать();
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеAPI(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат AIAPI_Общий.УИД(Значение);
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат AIAPI_Метаданные.СтавкаЧислом(Значение);
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция Обязательно(Ссылка, Поле)
	Если Ссылка = Неопределено Или Ссылка.ПолучитьОбъект() = Неопределено Тогда
		AIAPI_Общий.ВызватьОшибкуAPI(400, "bad_reference", "Не найден объект для " + Поле);
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция Ч(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(СтрЗаменить(Строка(Значение), ",", "."));
КонецФункции

// Также используется AIAPI_Объекты.
Процедура ЗаписатьЖурнал(ИД, Тело, Операция, Объект, До, После, Результат) Экспорт
	Запись = РегистрыСведений.ЖурналИзмененийAI.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторОдобрения = ИД;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Пользователь = Строка(Тело.Получить("approved_by"));
	Запись.Операция = Операция;
	Запись.Объект = ?(ТипЗнч(Объект) = Тип("Строка"), Объект, Строка(Объект) + " (" + AIAPI_Общий.УИД(Объект) + ")");
	Запись.ДоИзменения = ВJSON(До);
	Запись.ПослеИзменения = ВJSON(После);
	Запись.Результат = ВJSON(Результат);
	Запись.Записать(Истина);
КонецПроцедуры

Функция ВJSON(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

#КонецОбласти
